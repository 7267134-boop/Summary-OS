            <div id="os-glossary-questions" class="tab-content">
                <header class="mb-12 border-b pb-6">
                    <div
                        class="inline-block px-4 py-1 bg-racket text-white rounded-full font-bold text-sm mb-4 tracking-wider uppercase">
                        חלק 1.9
                    </div>
                    <h2 class="text-5xl font-black text-slate-800 tracking-tight mb-4">שאלות חזרה ובעיות פתורות</h2>
                    <p class="text-xl text-slate-600 leading-relaxed">
                        בעיות פתורות ושאלות חזרה מסכמות מתוך פרק 1 למדריך הלמידה.
                    </p>
                </header>
                <!-- שאלות חזרה מתוך מדריך הלמידה -->
                <div class="mt-12 pt-8 border-t border-slate-200">
                    <h3 class="text-2xl font-black text-slate-800 mb-6 flex items-center gap-2">
                        <span>❓ שאלות חזרה וסיכום (סעיף 1.9)</span>
                    </h3>
                    <p class="text-sm text-slate-600 mb-6 leading-relaxed">
                        להלן שאלות החזרה המופיעות בעמ' 22 במדריך הלמידה, בליווי פתרונות אקדמיים מעמיקים ודגשים מפורטים.
                        השתמש במתקפלים כדי לבחון את עצמך.
                    </p>

                    <div class="space-y-4">
                        <!-- Q1 -->
                        <details
                            class="bg-slate-50 border border-slate-200 rounded-xl p-5 group transition-all duration-300">
                            <summary
                                class="font-bold text-slate-800 cursor-pointer list-none flex items-center justify-between">
                                <span class="flex items-center gap-2">
                                    <span class="text-xs bg-slate-600 text-white px-2 py-0.5 rounded font-black">שאלה
                                        1</span>
                                    <span>האם תפקידה של מערכת ההפעלה כמכונה מורחבת מקבל ביטוי במערכת VM/370?</span>
                                </span>
                                <span
                                    class="text-slate-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                            </summary>
                            <div class="mt-4 pt-4 border-t border-slate-200/50 text-slate-700 text-sm leading-relaxed">
                                <div class="thought-box">
                                    <strong class="text-fuchsia-900 block mb-1">אסטרטגיית פתרון ומלכודות
                                        קלאסיות:</strong>
                                    סטודנטים רבים נוטים לחשוב ש-VM/370 עצמו מדמה את החומרה ולכן מתפקד כמכונה מורחבת. עם
                                    זאת, זכרו כי ה-Hypervisor (שכבת ה-CP) מדמה <b>חומרה גולמית</b> ובלתי-מרוסקת, ולא
                                    מציג אבסטרקציות נוחות. יש להבחין בין שכבת הווירטואליזציה לבין המערכות האורחות הרצות
                                    בתוכה.
                                </div>
                                <strong class="text-slate-800">הפתרון האקדמי:</strong>
                                <p class="mt-2">
                                    <b>כן, באופן עקיף.</b> שכבת הווירטואליזציה הפיזית (ה-Hypervisor או ה-Control
                                    Program) של מערכת <b>VM/370</b> אינה מספקת בעצמה את הפונקציות של "מכונה מורחבת" (היא
                                    אינה מנהלת קבצים או מספקת אבסטרקציות נוחות למתכנת, אלא משחזרת העתק מדויק של חומרת
                                    ה-System/370).
                                </p>
                                <p class="mt-2">
                                    עם זאת, המכונה המדומה מאפשרת להריץ בתוכה מערכת הפעלה אורחת חד-משתמשית כמו <b>CMS</b>
                                    (Conversational Monitor System). מערכת האורח CMS היא זו שמספקת למתכנת את אבסטרקציות
                                    המכונה המורחבת (קריאות מערכת, ניהול קבצים נוח, קלט/פלט מופשט) מעל החומרה המדומה
                                    שקיבלה.
                                </p>
                            </div>
                        </details>

                        <!-- Q2 -->
                        <details
                            class="bg-slate-50 border border-slate-200 rounded-xl p-5 group transition-all duration-300">
                            <summary
                                class="font-bold text-slate-800 cursor-pointer list-none flex items-center justify-between">
                                <span class="flex items-center gap-2">
                                    <span class="text-xs bg-slate-600 text-white px-2 py-0.5 rounded font-black">שאלה
                                        2</span>
                                    <span>האם ניתן להשיג הגנה על משאבי מערכת ההפעלה ללא תמיכה של מעבד בשני מצבים
                                        לפחות?</span>
                                </span>
                                <span
                                    class="text-slate-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                            </summary>
                            <div class="mt-4 pt-4 border-t border-slate-200/50 text-slate-700 text-sm leading-relaxed">
                                <div class="thought-box">
                                    <strong class="text-fuchsia-900 block mb-1">אסטרטגיית פתרון ומלכודות
                                        קלאסיות:</strong>
                                    שימו לב לשאלה זו – היא בוחנת את גבולות היכולת של מערכת הפעלה ללא תמיכת חומרה (Dual
                                    Mode). ללא מנגנון פיזי שמונע הרצת פקודות מסוימות במצב משתמש, תוכנות משתמש זדוניות או
                                    שגויות יכלו לשכתב את מערכת ההפעלה בקלות.
                                </div>
                                <strong class="text-slate-800">הפתרון האקדמי:</strong>
                                <p class="mt-2">
                                    <b>לא, לא ניתן להשיג הגנה הרמטית.</b> כדי להגן על משאבי המחשב (כמו הזיכרון הפיזי,
                                    התקני הקלט/פלט וטבלאות פסיקות), תוכניות משתמש רגילות חייבות להיות חסומות מביצוע
                                    הוראות מיוחסות (Privileged Instructions).
                                </p>
                                <p class="mt-2">
                                    חסימה זו מחייבת תמיכה פיזית של חומרת המעבד:
                                <ol class="list-decimal list-inside pr-4 mt-2 space-y-1">
                                    <li>מעבד התומך בלפחות שני מצבים (כמו User Mode ו-Kernel Mode).</li>
                                    <li>אכיפת מניעה מצד החומרה: אם תוכנית במצב משתמש מנסה להריץ הוראה מיוחסת, המעבד יסרב
                                        ויבצע פסיקה (Trap) המעבירה את השליטה למערכת ההפעלה.</li>
                                </ol>
                                ללא מנגנון זה בחומרה, כל תוכנית משתמש יכולה לעקוף את מערכת ההפעלה, לגשת ישירות לדיסק או
                                לזיכרון של תוכנית אחרת, ולא ניתן לממש הגנה.
                                </p>
                            </div>
                        </details>

                        <!-- Q3 -->
                        <details
                            class="bg-slate-50 border border-slate-200 rounded-xl p-5 group transition-all duration-300">
                            <summary
                                class="font-bold text-slate-800 cursor-pointer list-none flex items-center justify-between">
                                <span class="flex items-center gap-2">
                                    <span class="text-xs bg-slate-600 text-white px-2 py-0.5 rounded font-black">שאלה
                                        3</span>
                                    <span>אמתו או הפריכו: קריאות מערכת אינן גורמות למעבר למצב מיוחס (Kernel
                                        Mode).</span>
                                </span>
                                <span
                                    class="text-slate-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                            </summary>
                            <div class="mt-4 pt-4 border-t border-slate-200/50 text-slate-700 text-sm leading-relaxed">
                                <strong class="text-slate-800">הפתרון האקדמי:</strong>
                                <p class="mt-2">
                                    <b>הטענה מופרכת (לא נכונה).</b>
                                </p>
                                <p class="mt-2">
                                    קריאות מערכת (System Calls) הן המנגנון הרשמי והיחיד שבאמצעותו תוכנית משתמש רגילה
                                    (הרצה ב-User Mode) מבקשת שירותים ממערכת ההפעלה. ביצוע הקריאה מתבצע על ידי פקודת
                                    חומרה מיוחדת המכונה <b>Trap</b> או <b>Syscall</b>.
                                </p>
                                <p class="mt-2">
                                    פקודה זו מעבירה באופן מכוון ומבוקר את המעבד למצב מיוחס (Kernel Mode) ומעבירה את מונה
                                    הפקודות (PC) לכתובת קבועה בתוך קוד מערכת ההפעלה (Handler), כדי שזו תבצע את הפעולה
                                    המבוקשת בצורה מוגנת ומאובטחת.
                                </p>
                            </div>
                        </details>

                        <!-- Q4 -->
                        <details
                            class="bg-slate-50 border border-slate-200 rounded-xl p-5 group transition-all duration-300">
                            <summary
                                class="font-bold text-slate-800 cursor-pointer list-none flex items-center justify-between">
                                <span class="flex items-center gap-2">
                                    <span class="text-xs bg-slate-600 text-white px-2 py-0.5 rounded font-black">שאלה
                                        4</span>
                                    <span>אמתו או הפריכו: פונקציות של שפת תכנות עילית מבוצעות תמיד במצב מיוחס.</span>
                                </span>
                                <span
                                    class="text-slate-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                            </summary>
                            <div class="mt-4 pt-4 border-t border-slate-200/50 text-slate-700 text-sm leading-relaxed">
                                <div class="thought-box">
                                    <strong class="text-fuchsia-900 block mb-1">אסטרטגיית פתרון ומלכודות
                                        קלאסיות:</strong>
                                    שימו לב להבדל הברור בין פונקציות חישוביות רגילות לבין פונקציות המפעילות קריאות
                                    מערכת. פונקציית ספרייה כמו <code>printf()</code> של שפת C רצה במרחב משתמש ומבצעת
                                    הכנות רבות לפני שהיא מפעילה את קריאת המערכת הגולמית <code>write()</code>.
                                </div>
                                <strong class="text-slate-800">הפתרון האקדמי:</strong>
                                <p class="mt-2">
                                    <b>הטענה מופרכת (לא נכונה).</b>
                                </p>
                                <p class="mt-2">
                                    פונקציות של שפת תכנות עילית (למשל כפל מספרים, מניפולציה של מחרוזות, חישוב לוגי)
                                    מבוצעות כמעט תמיד במצב משתמש (User Mode). אין להן שום צורך או הרשאה לרוץ במצב מיוחס.
                                </p>
                                <p class="mt-2">
                                    רק כאשר פונקציה מסוימת זקוקה לשירותי חומרה או הגנה (למשל, הדפסה למסך באמצעות
                                    פונקציית ספרייה כמו <code>printf</code>, או הקצאת זיכרון דינמי באמצעות
                                    <code>malloc</code>), קוד הספרייה יבצע בסופו של דבר קריאת מערכת (System Call /
                                    Trap). המעבר למצב מיוחס מתבצע <b>אך ורק לזמן הטיפול בקריאת המערכת עצמה בתוך גרעין
                                        מערכת ההפעלה</b>, ולאחר סיומה המעבד חוזר מיד למצב משתמש רגיל.
                                </p>
                            </div>
                        </details>
                    </div>
                </div>
            </div>

        </div>

    </main>

    <!-- JAVASCRIPT SCOPING & SAFETY BLOCK -->
    <script>
        {
            // Simulator State
            let simStep = 1;
            const totalSimSteps = 11;
            let crashTerminalOpen = false;

            const simStepsData = {
                1: {
                    title: "שלב 1 מתוך 11: דחיפת nbytes למחסנית",
                    desc: "תוכנית המשתמש דוחפת את הפרמטר השלישי, <code>nbytes</code> (מספר הבתים לקריאה), למחסנית המשתמש (User Stack) בסדר הפוך לחתימת הפונקציה.",
                    cpuMode: "User Mode (Mode Bit = 1)",
                    cpuClass: "bg-green-100 text-green-700",
                    spVal: "0x7FFF0FFC",
                    eaxVal: "-",
                    activeCol: "user",
                    highlights: ["sim-box-user-app"],
                    stackItems: ["nbytes"]
                },
                2: {
                    title: "שלב 2 מתוך 11: דחיפת buffer למחסנית",
                    desc: "תוכנית המשתמש דוחפת את הפרמטר השני, <code>buffer</code> (מצביע הזיכרון לאחסון הנתונים שייקראו), למחסנית המשתמש.",
                    cpuMode: "User Mode (Mode Bit = 1)",
                    cpuClass: "bg-green-100 text-green-700",
                    spVal: "0x7FFF0FF8",
                    eaxVal: "-",
                    activeCol: "user",
                    highlights: ["sim-box-user-app"],
                    stackItems: ["nbytes", "buffer"]
                },
                3: {
                    title: "שלב 3 מתוך 11: דחיפת fd למחסנית",
                    desc: "תוכנית המשתמש דוחפת את הפרמטר הראשון, <code>fd</code> (מתאר הקובץ), למחסנית המשתמש. כעת <code>fd</code> בראש המחסנית.",
                    cpuMode: "User Mode (Mode Bit = 1)",
                    cpuClass: "bg-green-100 text-green-700",
                    spVal: "0x7FFF0FF4",
                    eaxVal: "-",
                    activeCol: "user",
                    highlights: ["sim-box-user-app"],
                    stackItems: ["nbytes", "buffer", "fd"]
                },
                4: {
                    title: "שלב 4 מתוך 11: מעבר לספריית ה-C",
                    desc: "מתבצעת פקודת <code>CALL</code> רגילה לפונקציית העטיפה (Wrapper) של <code>read</code> בספרייה. המעבד נשאר במצב משתמש (User Mode).",
                    cpuMode: "User Mode (Mode Bit = 1)",
                    cpuClass: "bg-green-100 text-green-700",
                    spVal: "0x7FFF0FF0",
                    eaxVal: "-",
                    activeCol: "user",
                    highlights: ["sim-box-user-lib"],
                    stackItems: ["nbytes", "buffer", "fd", "Return Address"]
                },
                5: {
                    title: "שלב 5 מתוך 11: טעינת אוגרים כהכנה לליבה",
                    desc: "הספרייה טוענת את קוד קריאת המערכת (למשל, 3) לאוגר <strong>EAX</strong>, ואת הפרמטרים מהמחסנית אל אוגרי חומרה (EBX, ECX, EDX) כדי שהליבה תוכל לקרוא אותם בבטחה.",
                    cpuMode: "User Mode (Mode Bit = 1)",
                    cpuClass: "bg-green-100 text-green-700",
                    spVal: "0x7FFF0FF0",
                    eaxVal: "3 (Syscall Code)",
                    activeCol: "user",
                    highlights: ["sim-box-user-lib"],
                    stackItems: ["nbytes", "buffer", "fd", "Return Address"]
                },
                6: {
                    title: "שלב 6 מתוך 11: פקודת ה-TRAP",
                    desc: "הפונקציה מבצעת הוראת חומרה <code>TRAP</code>. מנגנון החומרה משנה באופן חסוי את המצב ל-<strong>Kernel Mode (Bit=0)</strong>, שומר את ה-PC הנוכחי, וקופץ לווקטור הטיפול בפסיקות של מערכת ההפעלה.",
                    cpuMode: "Kernel Mode (Mode Bit = 0)",
                    cpuClass: "bg-red-100 text-red-700",
                    spVal: "0x7FFF0FF0",
                    eaxVal: "3 (Syscall Code)",
                    activeCol: "kernel",
                    highlights: ["sim-box-kernel-trap"],
                    stackItems: ["nbytes", "buffer", "fd", "Return Address"]
                },
                7: {
                    title: "שלב 7 מתוך 11: Dispatcher ושליפת פרמטרים",
                    desc: "מערכת ההפעלה קוראת את מספר הקריאה מ-EAX ומשתמשת בטבלת קריאות המערכת. הליבה <strong>לעולם לא</strong> סומכת על מחסנית המשתמש (מחשש לפריצות אבטחה כגון TOCTOU) וקוראת את הפרמטרים (fd, buffer, nbytes) ישירות מהאוגרים בהם הם אוחסנו.",
                    cpuMode: "Kernel Mode (Mode Bit = 0)",
                    cpuClass: "bg-red-100 text-red-700",
                    spVal: "0x7FFF0FF0",
                    eaxVal: "3",
                    activeCol: "kernel",
                    highlights: ["sim-box-kernel-trap", "sim-box-kernel-handler"],
                    stackItems: ["nbytes", "buffer", "fd", "Return Address"]
                },
                8: {
                    title: "שלב 8 מתוך 11: ביצוע בגרעין (sys_read)",
                    desc: "מטפל קריאות המערכת <code>sys_read</code> רץ בגרעין, בודק הרשאות ופונה לבקר החומרה (בקר הדיסק) כדי לקרוא את הנתונים הפיזית ולכתוב אותם ל-RAM.",
                    cpuMode: "Kernel Mode (Mode Bit = 0)",
                    cpuClass: "bg-red-100 text-red-700",
                    spVal: "0x7FFF0FF0",
                    eaxVal: "3",
                    activeCol: "kernel",
                    highlights: ["sim-box-kernel-handler", "sim-box-kernel-hw"],
                    stackItems: ["nbytes", "buffer", "fd", "Return Address"]
                },
                9: {
                    title: "שלב 9 מתוך 11: חזרה מליבה (פקודת IRET)",
                    desc: "הגרעין שם את ערך החזרה באוגר <code>EAX</code> (למשל, מספר הבתים שנקראו) ומבצע פקודת חזרה מיוחסת <code>IRET</code>. החומרה מחזירה את המעבד למצב משתמש (Mode Bit = 1).",
                    cpuMode: "User Mode (Mode Bit = 1)",
                    cpuClass: "bg-green-100 text-green-700",
                    spVal: "0x7FFF0FF0",
                    eaxVal: "1024 (Bytes read)",
                    activeCol: "user",
                    highlights: ["sim-box-user-lib"],
                    stackItems: ["nbytes", "buffer", "fd", "Return Address"]
                },
                10: {
                    title: "שלב 10 מתוך 11: חזרה אל תוכנית המשתמש",
                    desc: "פונקציית הספרייה read מקבלת את תוצאת הריצה מאוגר <code>EAX</code> ומחזירה אותה לתוכנית המשתמש שקראה לה.",
                    cpuMode: "User Mode (Mode Bit = 1)",
                    cpuClass: "bg-green-100 text-green-700",
                    spVal: "0x7FFF0FF4",
                    eaxVal: "1024",
                    activeCol: "user",
                    highlights: ["sim-box-user-app"],
                    stackItems: ["nbytes", "buffer", "fd"]
                },
                11: {
                    title: "שלב 11 מתוך 11: ניקוי המחסנית (Increment SP)",
                    desc: "תוכנית המשתמש מנקה את הארגומנטים מהמחסנית על ידי הגדלת מצביע המחסנית (SP) בשלוש מילים. קריאת המערכת הסתיימה בהצלחה!",
                    cpuMode: "User Mode (Mode Bit = 1)",
                    cpuClass: "bg-green-100 text-green-700",
                    spVal: "0x7FFF0000",
                    eaxVal: "1024",
                    activeCol: "user",
                    highlights: ["sim-box-user-app"],
                    stackItems: []
                }
            };


            // Modal Functions for Sidebar Q&A Triggers
            function showQuestions(tabId, sectionName, event) {
                if (event) event.stopPropagation(); // Prevent tab switching

                const repo = document.getElementById('questions-' + tabId);
                const modal = document.getElementById('questions-modal');
                const modalBody = document.getElementById('modal-body');
                const modalSectionName = document.getElementById('modal-section-name');

                if (!repo || !modal || !modalBody || !modalSectionName) return;

                let html = repo.innerHTML.trim();
                if (!html) {
                    html = `<div class="text-slate-500 text-center py-8">אין שאלות מנחות ליחידה זו.</div>`;
                }

                modalBody.innerHTML = html;
                modalSectionName.textContent = 'שאלות מנחות - ' + sectionName;

                modal.classList.remove('opacity-0', 'pointer-events-none');
                modal.querySelector('.transform').classList.remove('scale-95');
                modal.querySelector('.transform').classList.add('scale-100');

                // Reprocess MathJax
                if (window.MathJax && MathJax.typesetPromise) {
                    MathJax.typesetPromise([modalBody]).catch((err) => console.log(err.message));
                }
            }

            function closeQuestionsModal() {
                const modal = document.getElementById('questions-modal');
                if (!modal) return;
                modal.classList.add('opacity-0', 'pointer-events-none');
                const inner = modal.querySelector('.transform');
                if (inner) {
                    inner.classList.remove('scale-100');
                    inner.classList.add('scale-95');
                }
            }

            window.showQuestions = showQuestions;
            window.closeQuestionsModal = closeQuestionsModal;

            function showTab(tabId) {
                // hide all tabs, deactivate all nav buttons
                document.querySelectorAll('.tab-content').forEach(el => {
                    el.classList.remove('active');
                });
                document.querySelectorAll('.nav-btn').forEach(el => {
                    el.classList.remove('active-nav');
                });
                // show selected tab, activate matching button
                const activeTab = document.getElementById(tabId);
                if (activeTab) {
                    activeTab.classList.add('active');
                    const mainArea = document.querySelector('main');
                    if (mainArea) mainArea.scrollTop = 0;
                }
                const activeBtn = document.getElementById('btn-' + tabId);
                if (activeBtn) {
                    activeBtn.classList.add('active-nav');
                }
                // Save current tab in localStorage
                localStorage.setItem('activeTab_ch1', tabId);
                window.location.hash = tabId;
            }

            function toggleSidebar() {
                document.body.classList.toggle('sidebar-collapsed');
                const isCollapsed = document.body.classList.contains('sidebar-collapsed');
                localStorage.setItem('sidebarCollapsed', isCollapsed);
                updateToggleBtnIcon(isCollapsed);
            }

            function updateToggleBtnIcon(isCollapsed) {
                const icon = document.getElementById('sidebar-toggle-icon');
                if (!icon) return;
                if (isCollapsed) {
                    // Show << (chevron left to open/expand in RTL)
                    icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7M19 19l-7-7 7-7" />';
                } else {
                    // Show >> (chevron right to close/collapse in RTL)
                    icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" />';
                }
            }

            // Simulator Updates
            function updateSimView() {
                const step = simStepsData[simStep];
                if (!step) return;

                // Update info bar
                const modeEl = document.getElementById("sim-cpu-mode");
                modeEl.textContent = step.cpuMode;
                modeEl.className = "px-2 py-0.5 rounded font-bold " + step.cpuClass;
                document.getElementById("sim-sp").textContent = step.spVal;
                document.getElementById("sim-eax").textContent = step.eaxVal;

                // Update split columns
                const userCol = document.getElementById("sim-col-user");
                const kernelCol = document.getElementById("sim-col-kernel");
                if (step.activeCol === "user") {
                    userCol.className = "border-2 border-green-300 bg-green-50/50 p-5 rounded-2xl transition-all duration-300 shadow-sm";
                    kernelCol.className = "border border-slate-200 bg-slate-50/30 p-5 rounded-2xl transition-all duration-300 opacity-50 shadow-none";
                } else {
                    userCol.className = "border border-slate-200 bg-slate-50/30 p-5 rounded-2xl transition-all duration-300 opacity-50 shadow-none";
                    kernelCol.className = "border-2 border-red-300 bg-red-50/50 p-5 rounded-2xl transition-all duration-300 shadow-sm";
                }

                // Update element highlights
                const allBoxes = ["sim-box-user-app", "sim-box-user-lib", "sim-box-kernel-trap", "sim-box-kernel-handler", "sim-box-kernel-hw"];
                allBoxes.forEach(id => {
                    const el = document.getElementById(id);
                    if (el) {
                        const mb = (id === "sim-box-user-lib") ? "mb-4" : "mb-3";
                        el.className = `bg-white border border-slate-200/80 p-3 rounded-xl text-xs text-center ${mb} transition-all text-slate-700 shadow-sm font-medium`;
                    }
                });
                step.highlights.forEach(id => {
                    const el = document.getElementById(id);
                    if (el) {
                        const mb = (id === "sim-box-user-lib") ? "mb-4" : "mb-3";
                        el.className = `bg-blue-600 text-white border border-blue-700 p-3 rounded-xl text-xs text-center ${mb} transition-all font-bold shadow-md shadow-blue-500/20`;
                    }
                });

                // Update User Stack
                const stackEl = document.getElementById("sim-stack");
                stackEl.innerHTML = "";
                if (step.stackItems.length === 0) {
                    stackEl.innerHTML = '<div class="text-slate-400 text-center italic text-[10px]">מחסנית ריקה</div>';
                } else {
                    step.stackItems.forEach(item => {
                        const itemDiv = document.createElement("div");
                        itemDiv.className = "bg-slate-100 border border-slate-200 p-1.5 text-center text-slate-800 rounded font-mono text-[10px]";
                        itemDiv.textContent = item;
                        stackEl.appendChild(itemDiv);
                    });
                }

                // Update Control Texts
                document.getElementById("sim-step-title").textContent = step.title;
                document.getElementById("sim-step-desc").innerHTML = step.desc;

                // Disable buttons if at limits
                document.getElementById("sim-btn-prev").disabled = (simStep === 1);
                document.getElementById("sim-btn-next").disabled = (simStep === totalSimSteps);
            }

            function nextStepSim() {
                if (simStep < totalSimSteps) {
                    simStep++;
                    updateSimView();
                }
            }

            function prevStepSim() {
                if (simStep > 1) {
                    simStep--;
                    updateSimView();
                }
            }

            function resetSim() {
                simStep = 1;
                updateSimView();
                const term = document.getElementById("sim-crash-terminal");
                term.classList.add("hidden");
                term.innerHTML = "";
            }

            function runCrashTest() {
                const simulatorCard = document.getElementById("simulator-card-box");
                const terminal = document.getElementById("sim-crash-terminal");

                // Shake screen/card
                simulatorCard.classList.remove("shake-element");
                void simulatorCard.offsetWidth; // force reflow
                simulatorCard.classList.add("shake-element");

                terminal.classList.remove("hidden");
                terminal.innerHTML = "מבצע פקודת אסמבלי ישירה למרחב הפיזי: <code class='text-red-500 bg-red-950/20 border border-red-900/30 px-1 rounded' dir='ltr'>MOV [0x00000000], EAX</code>...<br>";

                setTimeout(() => {
                    terminal.innerHTML += "<span class='text-red-500 font-bold'>[CPU EXCEPTION] General Protection Fault (Privileged Instruction Exception in User Mode)</span><br>";
                    terminal.innerHTML += "<span class='text-slate-400'>[OS KERNEL] Access violation detected: process PID 1042 tried to bypass write restrictions.</span><br>";
                    terminal.innerHTML += "<span class='text-slate-400'>[OS KERNEL] Mode switched to Kernel Space to handle safety violation.</span><br>";
                    terminal.innerHTML += "<span class='text-red-500 font-bold'>[OS KERNEL] Action: Process terminated. Status: SIGSEGV (Segmentation Fault) - Core Dumped.</span>";
                }, 800);
            }

            // Document Initialization
            document.addEventListener("DOMContentLoaded", () => {
                // Close modal on click outside
                const qModal = document.getElementById('questions-modal');
                if (qModal) {
                    qModal.addEventListener('click', (e) => {
                        if (e.target === qModal) {
                            closeQuestionsModal();
                        }
                    });
                }
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') {
                        closeQuestionsModal();
                    }
                });

                // 1. Create and inject sidebar toggle button
                const toggleBtn = document.createElement('button');
                toggleBtn.id = 'sidebar-toggle-btn';
                toggleBtn.className = 'fixed top-6 p-2 rounded-lg bg-white/80 backdrop-blur-md hover:bg-white text-slate-600 hover:text-slate-900 border border-slate-200 shadow-md z-30 flex items-center justify-center w-10 h-10 transition-all duration-300 active:scale-95 cursor-pointer';
                toggleBtn.title = 'הצג/הסתר תפריט ניווט';
                toggleBtn.onclick = toggleSidebar;
                toggleBtn.innerHTML = '<svg id="sidebar-toggle-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"></svg>';
                document.body.appendChild(toggleBtn);

                // 2. Load sidebar collapsed state from localStorage
                const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
                if (isCollapsed) {
                    document.body.classList.add('sidebar-collapsed');
                }
                updateToggleBtnIcon(isCollapsed);

                // 3. Setup tabs hash routing or load from localStorage
                const hashTab = window.location.hash ? window.location.hash.substring(1) : null;
                const savedTab = localStorage.getItem('activeTab_ch1');
                const defaultTab = 'os-essence';
                const finalTab = hashTab || savedTab || defaultTab;
                showTab(finalTab);

                // 4. Initialize Simulator Visuals
                updateSimView();

                initFlashcards();

                // 5. Inject navigation buttons at the bottom of each tab
                const tabs = [];
                const seenIds = new Set();
                document.querySelectorAll('.tab-content').forEach(el => {
                    const id = el.id;
                    if (id && !seenIds.has(id)) {
                        seenIds.add(id);
                        tabs.push(el);
                    }
                });

                tabs.forEach((tab, index) => {
                    const navContainer = document.createElement('div');
                    navContainer.className = 'flex justify-between items-center mt-12 pt-6 border-t border-slate-200';

                    // Previous Button
                    if (index > 0) {
                        const prevTabId = tabs[index - 1].id;
                        const prevBtn = document.createElement('button');
                        prevBtn.onclick = () => showTab(prevTabId);
                        prevBtn.className = 'nav-btn-prev flex items-center gap-2 px-5 py-2.5 rounded-lg border border-slate-200 bg-white text-slate-700 font-medium hover:bg-slate-50 hover:text-slate-900 hover:border-slate-300 transition-all duration-200 shadow-sm text-sm cursor-pointer';
                        prevBtn.innerHTML = `
                            <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                            </svg>
                            <span>הקודם</span>
                        `;
                        navContainer.appendChild(prevBtn);
                    } else {
                        const placeholder = document.createElement('div');
                        placeholder.className = 'w-10 invisible';
                        navContainer.appendChild(placeholder);
                    }

                    // Next Button
                    if (index < tabs.length - 1) {
                        const nextTabId = tabs[index + 1].id;
                        const nextBtn = document.createElement('button');
                        nextBtn.onclick = () => showTab(nextTabId);
                        nextBtn.className = 'nav-btn-next flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-white font-medium hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-500/20 active:scale-[0.98] transition-all duration-200 shadow-sm text-sm cursor-pointer';
                        nextBtn.innerHTML = `
                            <span>הבא</span>
                            <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                            </svg>
                        `;
                        navContainer.appendChild(nextBtn);
                    } else {
                        const placeholder = document.createElement('div');
                        placeholder.className = 'w-10 invisible';
                        navContainer.appendChild(placeholder);
                    }

                    tab.appendChild(navContainer);
                });
            });


            // 1.3 Memory Hierarchy Pyramid State
            const pyramidData = {
                registers: {
                    title: "אוגרים (Registers)",
                    desc: "מהירות גישה: &lt; 1ns (מחזור שעון יחיד) | נפח טיפוסי: כמה מאות בתים.<br>האוגרים מובנים פיזית בליבת המעבד ומאפשרים לו לבצע עליהם פקודות מכונה ישירות במהירות האלקטרונית המרבית. ניהולם מבוצע במאה אחוז על ידי מהדר התוכנה או קוד האסמבלי."
                },
                cache: {
                    title: "זיכרון מטמון (Cache L1/L2/L3)",
                    desc: "מהירות גישה: 1ns - 10ns | נפח טיפוסי: 2MB - 64MB.<br>שבבי SRAM מהירים ביותר הממוקמים בצמידות או בתוך המעבד. הם שומרים העתקים של נתונים מבוקשים מתוך ה-RAM הראשי. ניהול הזיכרון מתבצע בחומרה על ידי בקר ה-Cache, אך מערכת ההפעלה מסנכרנת דפים ומנהלת תגי זיכרון מיוחדים."
                },
                ram: {
                    title: "זיכרון ראשי (RAM - Random Access Memory)",
                    desc: "מהירות גישה: 50ns - 100ns | נפח טיפוסי: 8GB - 64GB.<br>שבבי DRAM המהווים את 'מגרש המשחקים' הראשי של המערכת. כל תהליך שרץ חייב לטעון את הקוד והמשתנים שלו ל-RAM. מהירות הגישה איטית בהרבה מהמעבד, ולכן אוגרי המטמון קריטיים. מנוהל ישירות על ידי מערכת ההפעלה."
                },
                disk: {
                    title: "אחסון משני קבוע (SSD / HDD)",
                    desc: "מהירות גישה: 0.1ms (ב-SSD) עד 10ms (ב-HDD) | נפח טיפוסי: 512GB - 8TB.<br>זיכרון לא נדיף (שומר מידע בכיבוי חשמל). איטי בהרבה מרכיבי הסיליקון המקושרים ללוח האם. משמש לאחסון קבוע של קבצים ומערכת ההפעלה עצמה. מנוהל על ידי מערכת הקבצים של מערכת ההפעלה."
                }
            };

            function selectPyramidLayer(layerKey) {
                const detailBox = document.getElementById("pyramid-detail-box");
                const titleEl = document.getElementById("pyramid-detail-title");
                const descEl = document.getElementById("pyramid-detail-desc");

                const layer = pyramidData[layerKey];
                if (layer) {
                    titleEl.textContent = layer.title;
                    descEl.innerHTML = layer.desc;
                    detailBox.className = "flex-1 bg-blue-50/50 p-5 rounded-2xl border-2 border-blue-200 shadow-md transition-all";
                }
            }

            // 1.3 Interrupt Flow Simulator State
            let interruptStep = 0;
            let interruptChar = '';

            function triggerInterruptFlow(char) {
                interruptChar = char;
                interruptStep = 1;

                const nextBtn = document.getElementById("int-next-btn");
                nextBtn.disabled = false;
                nextBtn.classList.remove("opacity-50", "cursor-not-allowed");

                const terminal = document.getElementById("int-terminal");
                terminal.innerHTML = `<span class='text-blue-500 font-bold'>[מקלדת] המשתמש הקיש על מקש '${char}'. בקר המקלדת זיהה לחיצה פיזית.</span><br>`;

                updateInterruptView();
            }

            function nextInterruptStep() {
                if (interruptStep > 0 && interruptStep < 5) {
                    interruptStep++;
                    updateInterruptView();
                }
            }

            function updateInterruptView() {
                const terminal = document.getElementById("int-terminal");
                const pulse = document.getElementById("int-pulse");
                const hwKb = document.getElementById("int-hw-kb");
                const hwCpu = document.getElementById("int-hw-cpu");
                const hwIvt = document.getElementById("int-hw-ivt");
                const modeBitEl = document.getElementById("int-mode-bit");
                const cpuModeText = document.getElementById("int-cpu-mode-text");
                const spValEl = document.getElementById("int-sp-val");
                const nextBtn = document.getElementById("int-next-btn");

                hwKb.className = "border border-slate-200 bg-slate-50 p-3 rounded-lg text-center shadow-sm w-20 transition-all";
                hwCpu.className = "border border-slate-200 bg-slate-50 p-3 rounded-lg text-center shadow-sm w-24 transition-all";
                hwIvt.className = "border border-slate-200 bg-slate-50 p-2.5 rounded-lg text-center shadow-sm w-24 transition-all";
                pulse.style.width = "0%";

                if (interruptStep === 1) {
                    hwKb.className = "border-2 border-blue-500 bg-blue-50 p-3 rounded-lg text-center shadow-md w-20 transition-all";
                    terminal.innerHTML += "<b>שלב 1:</b> בקר המקלדת שולח אות פסיקת חומרה (Interrupt Signal) על גבי אפיק הבקרה למעבד.<br>";
                    pulse.style.width = "50%";
                }
                else if (interruptStep === 2) {
                    hwCpu.className = "border-2 border-red-500 bg-red-50 p-3 rounded-lg text-center shadow-md w-24 transition-all";
                    pulse.style.width = "100%";
                    terminal.innerHTML += "<b>שלב 2:</b> המעבד מסיים את פקודת המכונה הנוכחית, עוצר את התוכנית, ודוחף את ה-PC הנוכחי ואת ה-PSW למחסנית המשתמש.<br>";
                    spValEl.textContent = "0x7FFF0FF8";
                }
                else if (interruptStep === 3) {
                    hwCpu.className = "border-2 border-red-500 bg-red-50 p-3 rounded-lg text-center shadow-md w-24 transition-all";
                    hwIvt.className = "border-2 border-green-500 bg-green-50 p-2.5 rounded-lg text-center shadow-md w-24 transition-all";

                    modeBitEl.textContent = "0";
                    cpuModeText.textContent = "Mode: Kernel (0)";
                    cpuModeText.className = "text-[9px] text-red-600 mt-1 font-mono font-bold animate-pulse";

                    terminal.innerHTML += "<span class='text-red-500 font-bold'>[מעבד] ה-Mode Bit שונה ל-0 (Kernel Mode). המעבד ניגש לטבלת הפסיקות.</span><br>";
                    terminal.innerHTML += "<b>שלב 3:</b> המעבד קורא את כתובת ה-ISR עבור IRQ 1 מטבלת הפסיקות (Interrupt Table).<br>";
                }
                else if (interruptStep === 4) {
                    hwCpu.className = "border-2 border-red-500 bg-red-50 p-3 rounded-lg text-center shadow-md w-24 transition-all";
                    terminal.innerHTML += `<b>שלב 4:</b> הליבה מריצה את ה-ISR (מטפל הפסיקות של המקלדת), קוראת את התו '${interruptChar}' מבקר המקלדת, ומזינה אותו לחוצץ הקלט של ה-OS.<br>`;
                }
                else if (interruptStep === 5) {
                    modeBitEl.textContent = "1";
                    cpuModeText.textContent = "Mode: User (1)";
                    cpuModeText.className = "text-[9px] text-slate-500 mt-1 font-mono";
                    spValEl.textContent = "0x7FFF0000";

                    terminal.innerHTML += "<span class='text-green-500 font-bold'>[מעבד] בוצעה פקודת IRET. המעבד חוזר ל-User Mode (1), משחזר את PC מהמחסנית וממשיך את התוכנית.</span><br>";
                    terminal.innerHTML += `[סיום] התו '${interruptChar}' נקלט בהצלחה והתוכנית המשיכה לרוץ.`;

                    nextBtn.disabled = true;
                    nextBtn.classList.add("opacity-50", "cursor-not-allowed");
                }
            }

            function resetInterruptSim() {
                interruptStep = 0;
                interruptChar = '';

                const nextBtn = document.getElementById("int-next-btn");
                nextBtn.disabled = true;
                nextBtn.classList.add("opacity-50", "cursor-not-allowed");

                const pulse = document.getElementById("int-pulse");
                pulse.style.width = "0%";

                const hwKb = document.getElementById("int-hw-kb");
                const hwCpu = document.getElementById("int-hw-cpu");
                const hwIvt = document.getElementById("int-hw-ivt");

                hwKb.className = "border border-slate-200 bg-slate-50 p-3 rounded-lg text-center shadow-sm w-20 transition-all";
                hwCpu.className = "border border-slate-200 bg-slate-50 p-3 rounded-lg text-center shadow-sm w-24 transition-all";
                hwIvt.className = "border border-slate-200 bg-slate-50 p-2.5 rounded-lg text-center shadow-sm w-24 transition-all";

                document.getElementById("int-mode-bit").textContent = "1";
                const cpuModeText = document.getElementById("int-cpu-mode-text");
                cpuModeText.textContent = "Mode: User (1)";
                cpuModeText.className = "text-[9px] text-slate-500 mt-1 font-mono";
                document.getElementById("int-sp-val").textContent = "0x7FFF0000";

                document.getElementById("int-terminal").innerHTML = "[מערכת] הסימולטור מאופס.";
            }

            // 1.4 Matching Game State
            let matchingSelectedType = null;
            let matchingSelectedScen = null;
            let matchingScore = 0;
            const matchingCorrectPairs = {
                1: 'rt',
                2: 'srv',
                3: 'pc',
                4: 'emb'
            };
            const matchingMatchedScenarios = new Set();
            const matchingMatchedTypes = new Set();

            function selectMatchingCard(role, id) {
                const terminal = document.getElementById("matching-terminal");
                const gameCard = document.getElementById("matching-game-card");

                if (role === 'scen') {
                    if (matchingMatchedScenarios.has(id)) return;

                    if (matchingSelectedScen) {
                        document.getElementById(`match-scen-${matchingSelectedScen}`).classList.remove("selected");
                    }
                    matchingSelectedScen = id;
                    document.getElementById(`match-scen-${id}`).classList.add("selected");
                    terminal.innerHTML = `[משחק] נבחר תרחיש ${id}. בחרו כעת את מערכת ההפעלה המתאימה בצד שמאל.`;
                } else if (role === 'type') {
                    if (matchingMatchedTypes.has(id)) return;

                    if (matchingSelectedType) {
                        document.getElementById(`match-type-${matchingSelectedType}`).classList.remove("selected");
                    }
                    matchingSelectedType = id;
                    document.getElementById(`match-type-${id}`).classList.add("selected");
                    terminal.innerHTML = `[משחק] נבחרה מערכת ${id}. בחרו כעת את התרחיש המתאים בצד ימין.`;
                }

                if (matchingSelectedScen !== null && matchingSelectedType !== null) {
                    const expectedType = matchingCorrectPairs[matchingSelectedScen];

                    const scenCard = document.getElementById(`match-scen-${matchingSelectedScen}`);
                    const typeCard = document.getElementById(`match-type-${matchingSelectedType}`);

                    if (matchingSelectedType === expectedType) {
                        scenCard.classList.remove("selected");
                        typeCard.classList.remove("selected");
                        scenCard.classList.add("matched");
                        typeCard.classList.add("matched");

                        matchingMatchedScenarios.add(matchingSelectedScen);
                        matchingMatchedTypes.add(matchingSelectedType);

                        matchingScore++;
                        document.getElementById("matching-score").textContent = `${matchingScore} / 4`;

                        terminal.innerHTML = "<span class='text-green-500 font-bold'>[הצלחה] התאמה נכונה!</span> הצימוד בוצע בהצלחה.";

                        if (matchingScore === 4) {
                            terminal.innerHTML += "<br><span class='text-green-500 font-black'>כל הכבוד! פתרתם את כל ההתאמות בצורה מושלמת.</span>";
                        }
                    } else {
                        scenCard.classList.remove("selected");
                        typeCard.classList.remove("selected");
                        scenCard.classList.add("error");
                        typeCard.classList.add("error");

                        let errMsg = "צימוד שגוי!";
                        if (matchingSelectedScen === 1) {
                            errMsg = "שגיאה קריטית! קוצב לב דורש מערכת זמן-אמת קשיחה (Hard Real-Time). עיכוב של פולס חשמלי בשבר שנייה עלול לעלות בחיי אדם!";
                        } else if (matchingSelectedScen === 2 && matchingSelectedType === 'pc') {
                            errMsg = "שגיאה אקדמית! שרת בנק דורש זמינות ושרידות של מערכת שרתים. מערכת PC עלולה לקרוס תחת העומס ולגרור נזק כספי.";
                        } else if (matchingSelectedScen === 4 && matchingSelectedType === 'pc') {
                            errMsg = "שגיאה! שבב במדיח כלים הוא מערכת משובצת קטנה. מערכת PC דורשת משאבי עיבוד וזיכרון שאינם קיימים שם.";
                        }

                        terminal.innerHTML = `<span class='text-red-500 font-bold'>[באג הגנה] ${errMsg}</span>`;

                        gameCard.classList.remove("shake-element");
                        void gameCard.offsetWidth;
                        gameCard.classList.add("shake-element");

                        const sTemp = matchingSelectedScen;
                        const tTemp = matchingSelectedType;
                        setTimeout(() => {
                            if (!matchingMatchedScenarios.has(sTemp)) {
                                document.getElementById(`match-scen-${sTemp}`).classList.remove("error");
                            }
                            if (!matchingMatchedTypes.has(tTemp)) {
                                document.getElementById(`match-type-${tTemp}`).classList.remove("error");
                            }
                        }, 1500);
                    }

                    matchingSelectedScen = null;
                    matchingSelectedType = null;
                }
            }

            function resetMatchingGame() {
                matchingSelectedScen = null;
                matchingSelectedType = null;
                matchingScore = 0;
                matchingMatchedScenarios.clear();
                matchingMatchedTypes.clear();

                document.getElementById("matching-score").textContent = "0 / 4";
                document.getElementById("matching-terminal").innerHTML = "[מערכת] המשחק מאופס.";

                const cards = [
                    "match-scen-1", "match-scen-2", "match-scen-3", "match-scen-4",
                    "match-type-rt", "match-type-srv", "match-type-pc", "match-type-emb"
                ];

                cards.forEach(id => {
                    const card = document.getElementById(id);
                    card.className = "matching-card";
                });
            }

            // 1.5 Process States details
            const statesData = {
                ready: {
                    title: "מצב: מוכן (Ready)",
                    desc: "תהליך מוכן הוא תהליך שיש לו את כל המשאבים הדרושים לריצה (הוא טעון בזיכרון, קבציו מוכנים), והוא רק ממתין שמתזמן המעבד (Scheduler) יקצה לו את המעבד להרצה."
                },
                running: {
                    title: "מצב: רץ (Running)",
                    desc: "תהליך רץ הוא התהליך שמחזיק כעת במעבד ופקודותיו מבוצעות ברגע זה ממש על גבי החומרה הפיזית. במערכת עם מעבד בעל ליבה אחת, רק תהליך בודד יכול להיות במצב זה בכל רגע."
                },
                blocked: {
                    title: "מצב: חסום (Blocked / Waiting)",
                    desc: "תהליך חסום הוא תהליך שאינו יכול לרוץ גם אם המעבד פנוי לחלוטין, כיוון שהוא ממתין לאירוע חיצוני כלשהו שיקרה - למשל קבלת נתונים מהדיסק הקשיח, קלט מהמקלדת או הגעת חבילת מידע מהרשת."
                },
                "ready-to-running": {
                    title: "מעבר 3: הקצאת מעבד (Dispatch)",
                    desc: "מתרחש כאשר מתזמן מערכת ההפעלה בוחר בתהליך מסוים מתוך תור התהליכים המוכנים (Ready Queue) ומעביר לו את השליטה במעבד."
                },
                "running-to-ready": {
                    title: "מעבר 2: סיום קוואנטה (Timeout)",
                    desc: "מתרחש כאשר המעבד נלקח מהתהליך הרץ באופן יזום על ידי המערכת, לרוב בגלל שפרוסת זמן הריצה שלו (הקוואנטה) הסתיימה, על מנת להעבירה לתהליך אחר (תזמון Round Robin)."
                },
                "running-to-blocked": {
                    title: "מעבר 1: חסימה עקב המתנה (Block)",
                    desc: "מתרחש כאשר התהליך הרץ מבצע פעולת קלט/פלט (כמו קריאת קובץ) או ממתין למשאב. התהליך מוותר על המעבד מרצונו ועובר למצב חסום כדי לא לבזבז זמן מעבד."
                },
                "blocked-to-ready": {
                    title: "מעבר 4: התעוררות / אירוע הושלם (Wakeup)",
                    desc: "מתרחש כאשר האירוע שהתהליך החסום המתין לו קורה (למשל, ראש הדיסק סימה לקרוא את המידע). התהליך עובר לתור המוכנים וממתין למתזמן שיקצה לו מעבד שוב."
                }
            };

            function showStateInfo(key) {
                const titleEl = document.getElementById("state-detail-title");
                const descEl = document.getElementById("state-detail-desc");
                const detailBox = document.getElementById("state-detail-box");

                const data = statesData[key];
                if (data) {
                    titleEl.textContent = data.title;
                    descEl.textContent = data.desc;
                    detailBox.className = "mt-4 p-4 rounded-xl bg-blue-50 border-2 border-blue-200 shadow-md transition-all";
                }
            }


            // 1.7 Architectural Crash Test Simulator State
            function runCrashTestArchitecture(arch) {
                const terminal = document.getElementById("crash-sim-terminal");
                const monoBox = document.getElementById("mono-crash-box");
                const microBox = document.getElementById("micro-crash-box");
                const micDriver = document.getElementById("mic-driver-box");

                terminal.innerHTML = "";

                if (arch === 'mono') {
                    terminal.innerHTML = "<span class='text-red-500 font-bold'>[KBUG] באג חלוקה באפס התרחש בקוד דרייבר התצוגה (Ring 0)!</span><br>";

                    monoBox.classList.remove("shake-element");
                    void monoBox.offsetWidth;
                    monoBox.classList.add("shake-element");

                    setTimeout(() => {
                        terminal.innerHTML += "<span class='text-red-500 font-black'>[KERNEL CRITICAL] Double Fault Exception. לא ניתן להתאושש משגיאת ליבה.</span><br>";
                        terminal.innerHTML += "<span class='text-blue-400 font-bold'>[BSOD] *** STOP: 0x000000EA (THREAD_STUCK_IN_DEVICE_DRIVER). המערכת הושבתה למניעת נזק.</span>";

                        monoBox.className = "bg-blue-600 text-white p-5 rounded-xl border-2 border-blue-700 shadow-lg min-h-[160px] font-mono text-[9px] flex flex-col justify-between";
                        document.getElementById("mono-crash-desc").innerHTML = "A problem has been detected and Windows has been shut down to prevent damage to your computer...<br><br>Technical Information:<br>*** STOP: 0x000000EA";
                    }, 800);
                } else if (arch === 'micro') {
                    terminal.innerHTML = "[USER-SPACE] באג חלוקה באפס בשרת התצוגה (Process PID 45, User Mode)...<br>";

                    microBox.classList.remove("shake-element");
                    void microBox.offsetWidth;
                    microBox.classList.add("shake-element");

                    micDriver.className = "bg-red-500 text-white border border-red-600 p-1.5 rounded animate-pulse";

                    setTimeout(() => {
                        terminal.innerHTML += "<span class='text-amber-500 font-bold'>[MICROKERNEL] שרת התצוגה הושבת. מזהה שגיאה בתהליך מבודד במרחב משתמש.</span><br>";

                        setTimeout(() => {
                            terminal.innerHTML += "<span class='text-green-500 font-bold'>[RECOVERY] שרת ה-Reincarnation של הליבה מאתחל שרת תצוגה חדש במרחב משתמש...</span><br>";

                            setTimeout(() => {
                                micDriver.className = "bg-indigo-50 border border-indigo-200 p-1.5 rounded";
                                terminal.innerHTML += "[סיום] שרת התצוגה חזר לפעול בצורה תקינה. המערכת שרדה לחלוטין ללא קריסה!";
                            }, 800);
                        }, 800);
                    }, 800);
                }
            }

            function resetCrashTestArchitecture() {
                const monoBox = document.getElementById("mono-crash-box");
                const microBox = document.getElementById("micro-crash-box");
                const micDriver = document.getElementById("mic-driver-box");
                const terminal = document.getElementById("crash-sim-terminal");

                monoBox.className = "bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between min-h-[160px]";
                document.getElementById("mono-crash-desc").innerHTML = "נהג התצוגה רץ בתוך ה-Kernel Mode (Ring 0). יש לו הרשאות כתיבה חופשיות לכל מקום.";

                microBox.className = "bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between min-h-[160px]";
                document.getElementById("micro-crash-desc").innerHTML = "נהג התצוגה רץ כתהליך משתמש רגיל (Ring 3). הזיכרון שלו מבודד ומנוהל על ידי ה-MMU.";

                micDriver.className = "bg-indigo-50 border border-indigo-200 p-1.5 rounded";
                terminal.innerHTML = "[מערכת] הסימולטור מאופס.";
            }

            // 1.8 Flashcard Deck State & Logic
            let flashcardMode = 'study'; // 'study' or 'test'
            let flashcardActiveCategory = 'הכל';
            let openedFlashcards = new Set();

            // Loaded glossary array is injected by Python build script
            const flashcardData = [
                {
                    "term": "מערכת הפעלה (Operating System - OS)",
                    "definition": "שכבת התוכנה הראשונה הרצה ישירות מעל החומרה במצב מיוחס. תפקידה לספק לתוכניות המשתמש מודל נקי ופשוט של המחשב, ולנהל את כל משאבי המערכת ביעילות ובבטחה.",
                    "category": "קבוצה א': תפקידי מערכת ההפעלה ומבט-על"
                },
                {
                    "term": "מכונה מורחבת / מדומה (Extended / Virtual Machine)",
                    "definition": "נקודת המבט מלעיל-למטה (Top-Down) על מערכת ההפעלה. המערכת מציגה למשתמש אבסטרקציות (הפשטות) נוחות, ובכך מסתירה את המורכבות והפרטים המייגעים של החומרה הגולמית.",
                    "category": "קבוצה א': תפקידי מערכת ההפעלה ומבט-על"
                },
                {
                    "term": "מנהל משאבים (Resource Manager)",
                    "definition": "נקודת המבט מלמטה-למעלה (Bottom-Up) על מערכת ההפעלה. המערכת פועלת כבורר וכמנהל מרכזי שתפקידו להקצות משאבים מוגבלים (מעבד, זיכרון, התקנים) בין תהליכים שונים המתחרים עליהם במקביל.",
                    "category": "קבוצה א': תפקידי מערכת ההפעלה ומבט-על"
                },
                {
                    "term": "ריבוב בזמן (Time Multiplexing)",
                    "definition": "שיטה לניהול משאבים שבה משאב פיזי יחיד (כמו מעבד) מחולק בין מספר תהליכים על ציר הזמן — תהליך אחד משתמש במשאב לזמן קצר, ואז מפנה אותו לטובת תהליך אחר.",
                    "category": "קבוצה א': תפקידי מערכת ההפעלה ומבט-על"
                },
                {
                    "term": "ריבוב במרחב (Space Multiplexing)",
                    "definition": "שיטה לניהול משאבים שבה משאב פיזי (כמו זיכרון ראשי או דיסק קשיח) מחולק פיזית ובו-זמנית בין מספר צרכנים, כאשר כל אחד מקבל \"חתיכה\" או מקטע נפרד משלו במרחב.",
                    "category": "קבוצה א': תפקידי מערכת ההפעלה ומבט-על"
