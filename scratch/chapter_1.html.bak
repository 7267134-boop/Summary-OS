                {
                    "term": "קיפאון (Deadlock)",
                    "definition": "מצב שבו שני תהליכים (או יותר) חסומים וממתינים זה לזה באופן מעגלי לקבלת משאב שהשני מחזיק, כך שאף אחד מהם אינו יכול להמשיך בריצתו.",
                    "category": "קבוצה ד': מושגי היסוד הלוגיים"
                },
                {
                    "term": "fork()",
                    "definition": "קריאת מערכת ייחודית המשכפלת את התהליך הקורא (האב) ומייצרת תהליך חדש לחלוטין (הבן). היא מחזירה את מזהה התהליך (PID) של הבן לאב, ו-0 לבן.",
                    "category": "קבוצה ה': קריאות מערכת ליבה"
                },
                {
                    "term": "execve() / exec()",
                    "definition": "קריאת מערכת הטוענת קובץ הרצה חדש מהדיסק אל תוך התהליך הנוכחי, ודורסת לחלוטין את הקוד והנתונים הקודמים שלו. התהליך משנה את זהותו ומריץ את התוכנית החדשה.",
                    "category": "קבוצה ה': קריאות מערכת ליבה"
                },
                {
                    "term": "wait()",
                    "definition": "קריאה הגורמת לתהליך האב להשעות את ריצתו (להיחסם) עד שאחד מתהליכי הבנים שלו יסיים את ריצתו.",
                    "category": "קבוצה ה': קריאות מערכת ליבה"
                },
                {
                    "term": "exit()",
                    "definition": "קריאה שבאמצעותה תהליך מודיע באופן יזום למערכת ההפעלה שהוא סיים את עבודתו, מה שגורם לשחרור כל משאביו בזיכרון והעברת סטטוס סיום לאב.",
                    "category": "קבוצה ה': קריאות מערכת ליבה"
                },
                {
                    "term": "מערכת מונוליתית (Monolithic System)",
                    "definition": "מבנה שבו כל רכיבי מערכת ההפעלה (ניהול זיכרון, קבצים, דרייברים) מקומפלים יחד לקובץ הרצה יחיד וגדול הרץ כולו ב-Kernel Mode. מהיר מאוד אך פגיע לקריסות.",
                    "category": "קבוצה ו': מבנה מערכות הפעלה"
                },
                {
                    "term": "מערכת מרובדות (Layered System)",
                    "definition": "תכנון היררכי שבו המערכת מחולקת לשכבות, כאשר כל שכבה משתמשת רק בשירותי השכבה שמתחתיה ומשרתת רק את זו שמעליה.",
                    "category": "קבוצה ו': מבנה מערכות הפעלה"
                },
                {
                    "term": "מיקרו-קרנל (Microkernel)",
                    "definition": "ארכיטקטורה שבה הגרעין מצומצם למינימום ההכרחי (רק תקשורת IPC ותזמון בסיסי), בעוד שאר השירותים (מערכת קבצים, דרייברים) רצים כתהליכי משתמש רגילים ומבודדים (שרתים).",
                    "category": "קבוצה ו': מבנה מערכות הפעלה"
                },
                {
                    "term": "מודל שרת-לקוח (Client-Server)",
                    "definition": "מודל העבודה בתוך מיקרו-קרנל — תהליך משתמש (\"לקוח\") מבקש שירות על ידי שליחת הודעה דרך הגרעין לתהליך מערכת הפעלה (\"שרת\"), וממתין לתשובה.",
                    "category": "קבוצה ו': מבנה מערכות הפעלה"
                },
                {
                    "term": "Hypervisor / VMM (Virtual Machine Monitor)",
                    "definition": "שכבת תוכנה הרצה ישירות על החומרה הפיזית ומדמה אותה מספר פעמים, כדי לאפשר הרצה של מספר מערכות הפעלה שלמות ושונות במקביל על אותו מחשב.",
                    "category": "קבוצה ו': מבנה מערכות הפעלה"
                },
                {
                    "term": "Exokernel",
                    "definition": "ארכיטקטורה שבה הגרעין אינו מספק אבסטרקציות כלל, אלא רק מקצה ומגן על משאבי חומרה גולמיים עבור ספריות ברמת המשתמש (Library OS), המממשות את האבסטרקציות בעצמן באופן מותאם אישית.",
                    "category": "קבוצה ו': מבנה מערכות הפעלה"
                },
                {
                    "term": "ממשק פקודה (CLI) מול ממשק גרפי (GUI)",
                    "definition": "GUI (Graphical User Interface) מספק חלונות ועכבר לנוחות, בעוד ש-CLI (Command Line Interface) כמו ה-Shell מהווה תוכנית מבוססת טקסט המקבלת פקודות ישירות ומפעילה קריאות מערכת.",
                    "category": "קבוצה א': תפקידי מערכת ההפעלה ומבט-על"
                },
                {
                    "term": "תקן POSIX",
                    "definition": "תקן בין-לאומי המגדיר סט אחיד של קריאות מערכת (API) שמערכות הפעלה מבוססות UNIX חייבות לתמוך בו, על מנת להבטיח ניידות קוד ממערכת אחת לאחרת.",
                    "category": "קבוצה ה': קריאות מערכת ליבה"
                }
            ];

            const catMap = {
                "קבוצה א': תפקידי מערכת ההפעלה ומבט-על": "תפקידים ומבט-על",
                "קבוצה ב': אבולוציה היסטורית": "היסטוריה",
                "קבוצה ג': ארכיטקטורת חומרה ומנגנוני הגנה": "חומרה והגנה",
                "קבוצה ד': מושגי היסוד הלוגיים": "מושגים לוגיים",
                "קבוצה ה': קריאות מערכת ליבה": "קריאות מערכת",
                "קבוצה ו': מבנה מערכות הפעלה": "מבנה מערכות"
            };

            function initFlashcards() {
                const categories = ['הכל', ...new Set(flashcardData.map(item => catMap[item.category] || item.category))];
                const tabsContainer = document.getElementById("flashcard-categories-tabs");
                tabsContainer.innerHTML = "";

                categories.forEach(cat => {
                    const tabBtn = document.createElement("button");
                    tabBtn.className = cat === flashcardActiveCategory
                        ? "bg-slate-800 text-white font-bold py-1.5 px-3 rounded-lg text-xs transition-all cursor-pointer shadow-sm active:scale-95"
                        : "bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-1.5 px-3 rounded-lg text-xs transition-all cursor-pointer active:scale-95";
                    tabBtn.textContent = cat;
                    tabBtn.onclick = () => filterFlashcards(cat);
                    tabsContainer.appendChild(tabBtn);
                });

                renderFlashcards();
            }

            function setFlashcardMode(mode) {
                flashcardMode = mode;

                const btnStudy = document.getElementById("flashcard-mode-study");
                const btnTest = document.getElementById("flashcard-mode-test");
                const statsEl = document.getElementById("flashcard-stats-container");

                if (mode === 'study') {
                    btnStudy.className = "bg-blue-600 text-white font-bold py-1.5 px-4 rounded-lg text-xs transition-all cursor-pointer shadow-sm shadow-blue-500/10 active:scale-95";
                    btnTest.className = "bg-slate-200 text-slate-700 hover:bg-slate-300 font-bold py-1.5 px-4 rounded-lg text-xs transition-all cursor-pointer active:scale-95";
                    statsEl.classList.add("hidden");
                } else {
                    btnStudy.className = "bg-slate-200 text-slate-700 hover:bg-slate-300 font-bold py-1.5 px-4 rounded-lg text-xs transition-all cursor-pointer active:scale-95";
                    btnTest.className = "bg-blue-600 text-white font-bold py-1.5 px-4 rounded-lg text-xs transition-all cursor-pointer shadow-sm shadow-blue-500/10 active:scale-95";
                    statsEl.classList.remove("hidden");
                }

                renderFlashcards();
            }

            function filterFlashcards(category) {
                flashcardActiveCategory = category;

                const tabs = document.getElementById("flashcard-categories-tabs").children;
                for (let tab of tabs) {
                    if (tab.textContent === category) {
                        tab.className = "bg-slate-800 text-white font-bold py-1.5 px-3 rounded-lg text-xs transition-all cursor-pointer shadow-sm active:scale-95";
                    } else {
                        tab.className = "bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-1.5 px-3 rounded-lg text-xs transition-all cursor-pointer active:scale-95";
                    }
                }

                renderFlashcards();
            }

            function renderFlashcards() {
                const deck = document.getElementById("flashcard-deck");
                deck.innerHTML = "";

                const filteredData = flashcardData.filter(item => {
                    const mappedCat = catMap[item.category] || item.category;
                    return flashcardActiveCategory === 'הכל' || mappedCat === flashcardActiveCategory;
                });

                document.getElementById("flashcard-total-count").textContent = filteredData.length;

                let openedFiltered = 0;
                filteredData.forEach(item => {
                    if (openedFlashcards.has(item.term)) openedFiltered++;
                });
                document.getElementById("flashcard-opened-count").textContent = openedFiltered;

                filteredData.forEach((item, index) => {
                    const cardScene = document.createElement("div");

                    if (flashcardMode === 'study') {
                        cardScene.className = "flashcard-scene flat-mode";
                        cardScene.innerHTML = `
                            <div class="flashcard-card">
                                <div class="flashcard-face flashcard-front">
                                    <div>
                                        <span class="text-[9px] font-bold text-blue-600 bg-blue-100/60 border border-blue-200/50 px-2 py-0.5 rounded-full mb-2 inline-block">${catMap[item.category] || item.category}</span>
                                        <h4 class="text-sm font-black text-slate-800 leading-tight">${item.term}</h4>
                                    </div>
                                </div>
                                <div class="flashcard-face flashcard-back">
                                    <p class="text-xs text-slate-600 leading-relaxed">${item.definition}</p>
                                </div>
                            </div>
                        `;
                    } else {
                        const isFlipped = openedFlashcards.has(item.term);
                        cardScene.className = isFlipped ? "flashcard-scene flipped" : "flashcard-scene";
                        cardScene.onclick = () => toggleFlashcard(cardScene, item.term);

                        cardScene.innerHTML = `
                            <div class="flashcard-card">
                                <div class="flashcard-face flashcard-front flex flex-col justify-between">
                                    <div>
                                        <span class="text-[9px] font-bold text-blue-600 bg-blue-100/60 border border-blue-200/50 px-2 py-0.5 rounded-full mb-2 inline-block">${catMap[item.category] || item.category}</span>
                                        <h4 class="text-sm font-black text-slate-800 leading-tight mt-1">${item.term}</h4>
                                    </div>
                                    <div class="text-[9px] text-slate-400 font-bold border-t pt-2 border-slate-100 flex items-center justify-between">
                                        <span>לחיצה לחשיפה</span>
                                        <span>❓</span>
                                    </div>
                                </div>
                                <div class="flashcard-face flashcard-back flex flex-col justify-between font-sans">
                                    <div class="overflow-y-auto pr-1">
                                        <span class="text-[9px] font-bold text-slate-400 bg-slate-100 border border-slate-200/50 px-2 py-0.5 rounded-full mb-2 inline-block">${catMap[item.category] || item.category}</span>
                                        <h5 class="text-xs font-black text-slate-700 leading-tight mt-1">${item.term}</h5>
                                        <p class="text-[11px] text-slate-600 leading-relaxed mt-2" dir="rtl">${item.definition}</p>
                                    </div>
                                    <div class="text-[9px] text-blue-500 font-bold border-t pt-1.5 border-slate-200 flex items-center justify-between select-none">
                                        <span>נחשף</span>
                                        <span>✓</span>
                                    </div>
                                </div>
                            </div>
                        `;
                    }

                    deck.appendChild(cardScene);
                });
            }

            function toggleFlashcard(el, term) {
                if (flashcardMode === 'study') return;

                if (openedFlashcards.has(term)) {
                    openedFlashcards.delete(term);
                    el.classList.remove("flipped");
                } else {
                    openedFlashcards.add(term);
                    el.classList.add("flipped");
                }

                let openedFiltered = 0;
                flashcardData.forEach(item => {
                    const mappedCat = catMap[item.category] || item.category;
                    const isInCategory = (flashcardActiveCategory === 'הכל' || mappedCat === flashcardActiveCategory);
                    if (isInCategory && openedFlashcards.has(item.term)) openedFiltered++;
                });
                document.getElementById("flashcard-opened-count").textContent = openedFiltered;
            }

            function resetFlashcards() {
                openedFlashcards.clear();
                renderFlashcards();
            }

            // === 1.1 Perspectives Sandbox ===
            function switchPerspective(view) {
                const topdownView = document.getElementById('persp-topdown-view');
                const bottomupView = document.getElementById('persp-bottomup-view');
                const btnTopdown = document.getElementById('btn-persp-topdown');
                const btnBottomup = document.getElementById('btn-persp-bottomup');

                if (!topdownView || !bottomupView) return;

                if (view === 'topdown') {
                    btnTopdown.className = "px-4 py-2 rounded-md text-xs font-bold transition-all bg-blue-600 text-white shadow-sm";
                    btnBottomup.className = "px-4 py-2 rounded-md text-xs font-bold transition-all text-slate-400 hover:text-white";
                    bottomupView.style.opacity = '0';
                    bottomupView.style.pointerEvents = 'none';
                    setTimeout(() => {
                        topdownView.style.opacity = '1';
                        topdownView.style.pointerEvents = 'auto';
                    }, 300);
                } else {
                    btnBottomup.className = "px-4 py-2 rounded-md text-xs font-bold transition-all bg-blue-600 text-white shadow-sm";
                    btnTopdown.className = "px-4 py-2 rounded-md text-xs font-bold transition-all text-slate-400 hover:text-white";
                    topdownView.style.opacity = '0';
                    topdownView.style.pointerEvents = 'none';
                    setTimeout(() => {
                        bottomupView.style.opacity = '1';
                        bottomupView.style.pointerEvents = 'auto';
                    }, 300);
                }
            }

            // Removed 1.1 Memory Isolation (MMU) per user request



            // === 1.4 Constraint Lab ===
            let constraintActiveTask = null;
            let constraintMatched = new Set();

            function selectConstraintTask(taskId) {
                if (constraintMatched.has(taskId)) return;
                constraintActiveTask = taskId;
                ['mainframe', 'server', 'multiprocessor', 'pc', 'rt', 'embedded'].forEach(t => {
                    const el = document.getElementById('task-' + t);
                    if (el && !constraintMatched.has(t)) el.classList.remove('border-blue-500', 'bg-blue-50');
                });

                const selectedEl = document.getElementById('task-' + taskId);
                if (selectedEl) selectedEl.classList.add('border-blue-500', 'bg-blue-50');

                // Enable solutions
                ['mainframe', 'server', 'multiprocessor', 'pc', 'rt', 'embedded'].forEach(s => {
                    if (!constraintMatched.has(s)) {
                        const el = document.getElementById('sol-' + s);
                        if (el) el.classList.remove('opacity-50', 'pointer-events-none');
                    }
                });
            }

            function selectConstraintSolution(solId) {
                if (!constraintActiveTask || constraintMatched.has(solId) || constraintMatched.has(constraintActiveTask)) return;

                const taskId = constraintActiveTask;
                const taskEl = document.getElementById('task-' + taskId);
                const solEl = document.getElementById('sol-' + solId);
                const gridEl = document.getElementById('constraint-lab-grid');
                const svgEl = document.getElementById('constraint-lines-svg');

                if (!taskEl || !solEl || !gridEl || !svgEl) return;

                const gridRect = gridEl.getBoundingClientRect();
                const taskRect = taskEl.getBoundingClientRect();
                const solRect = solEl.getBoundingClientRect();

                // Calculate center points relative to the grid
                const x1 = taskRect.left + taskRect.width / 2 - gridRect.left;
                const y1 = taskRect.top + taskRect.height / 2 - gridRect.top;
                const x2 = solRect.left + solRect.width / 2 - gridRect.left;
                const y2 = solRect.top + solRect.height / 2 - gridRect.top;

                const isMatch = (taskId === solId);

                // Create SVG line
                const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('x1', x1);
                line.setAttribute('y1', y1);
                line.setAttribute('x2', x2);
                line.setAttribute('y2', y2);
                line.setAttribute('stroke-width', '3');
                line.setAttribute('stroke-linecap', 'round');

                if (isMatch) {
                    line.setAttribute('stroke', '#22c55e'); // Green
                    svgEl.appendChild(line);

                    constraintMatched.add(taskId);

                    taskEl.classList.replace('border-blue-500', 'border-green-500');
                    taskEl.classList.replace('bg-blue-50', 'bg-green-50');
                    solEl.classList.add('border-green-500', 'bg-green-50');
                    taskEl.classList.add('pointer-events-none');
                    solEl.classList.add('pointer-events-none');

                    constraintActiveTask = null;
                } else {
                    line.setAttribute('stroke', '#ef4444'); // Red
                    line.setAttribute('stroke-dasharray', '8,8');
                    svgEl.appendChild(line);

                    solEl.classList.add('border-red-500', 'bg-red-50');

                    setTimeout(() => {
                        svgEl.removeChild(line);
                        solEl.classList.remove('border-red-500', 'bg-red-50');
                    }, 1000);
                }
            }

            // === 1.5 MMU Segfault ===
            function triggerSegfault() {
                const textSeg = document.getElementById('mem-seg-text');
                const stackSeg = document.getElementById('mem-seg-stack');
                const heapSeg = document.getElementById('mem-seg-heap');
                const arrow = document.getElementById('hacker-arrow');
                const overlay = document.getElementById('mem-segfault-overlay');

                // Reset
                overlay.classList.replace('flex', 'hidden');
                textSeg.classList.remove('animate-shake', 'border-red-500');

                // Animate arrow
                arrow.style.transform = 'scaleX(1)';

                setTimeout(() => {
                    arrow.style.transform = 'scaleX(0)';
                    overlay.classList.replace('hidden', 'flex');
                    textSeg.classList.add('animate-shake', 'border-red-500');
                }, 400);

                setTimeout(() => {
                    overlay.classList.replace('flex', 'hidden');
                    textSeg.classList.remove('animate-shake', 'border-red-500');
                }, 2500);
            }

            // === 1.7 Architecture Sandbox ===
            function updateArchSandbox(archType) {
                // Reset active button state
                ['monolithic', 'layered', 'microkernel', 'vm', 'exokernel'].forEach(type => {
                    const btn = document.getElementById('btn-arch-' + type);
                    if (btn) {
                        btn.classList.remove('bg-blue-50', 'border-blue-500', 'text-blue-800');
                        btn.classList.add('bg-white', 'text-slate-700');
                    }
                });

                // Set active button
                const activeBtn = document.getElementById('btn-arch-' + archType);
                if (activeBtn) {
                    activeBtn.classList.remove('bg-white', 'text-slate-700');
                    activeBtn.classList.add('bg-blue-50', 'border-blue-500', 'text-blue-800');
                }

                // Elements
                const title = document.getElementById('arch-sim-title');
                const desc = document.getElementById('arch-sim-desc');
                const perfVal = document.getElementById('arch-sim-perf-val');
                const perfBar = document.getElementById('arch-sim-perf-bar');
                const stabVal = document.getElementById('arch-sim-stab-val');
                const stabBar = document.getElementById('arch-sim-stab-bar');
                const sizeVal = document.getElementById('arch-sim-size-val');
                const sizeBar = document.getElementById('arch-sim-size-bar');

                if (!title) return;

                // Update data
                setTimeout(() => {
                    if (archType === 'monolithic') {
                        title.textContent = 'מערכת מונוליתית (Linux / Windows)';
                        perfVal.textContent = 'גבוה מאוד (100%)';
                        perfBar.style.width = '100%';
                        stabVal.textContent = 'נמוכה (30%)';
                        stabBar.style.width = '30%';
                        sizeVal.textContent = 'ענק (100%)';
                        sizeBar.style.width = '100%';
                        desc.innerHTML = '<strong>ניתוח:</strong> הגרעין מכיל את כל שירותי המערכת. אין תקורה של החלפות הקשר (Context Switch) ולכן הביצועים מעולים. עם זאת, הגרעין מנופח (עשרות מיליוני שורות קוד), ובאג בדרייבר מדפסת פשוט יגרום ל-Kernel Panic ויקריס את המחשב כולו.';
                    } else if (archType === 'layered') {
                        title.textContent = 'מערכת מרובדות (THE / MULTICS)';
                        perfVal.textContent = 'בינוני (60%)';
                        perfBar.style.width = '60%';
                        stabVal.textContent = 'בינונית (60%)';
                        stabBar.style.width = '60%';
                        sizeVal.textContent = 'גדול (70%)';
                        sizeBar.style.width = '70%';
                        desc.innerHTML = '<strong>ניתוח:</strong> הקוד מאורגן בשכבות מבודדות. משפר את יכולת האיתור של באגים (Debugging), אך הפנייה דרך שכבות מרובות גורמת להאטה. בפועל, קשה מאוד לתכנן מודל היררכי טהור בעולם האמיתי.';
                    } else if (archType === 'microkernel') {
                        title.textContent = 'מיקרו-קרנל (MINIX / QNX)';
                        perfVal.textContent = 'נמוך (40%)';
                        perfBar.style.width = '40%';
                        stabVal.textContent = 'גבוהה מאוד (100%)';
                        stabBar.style.width = '100%';
                        sizeVal.textContent = 'זעיר (10%)';
                        sizeBar.style.width = '10%';
                        desc.innerHTML = '<strong>ניתוח:</strong> הגרעין מזערי ומטפל רק בתזמון ותקשורת (IPC). שאר השירותים רצים כתוכניות משתמש (Servers). יציבות פנומנלית: קריסת שרת תוביל לאתחולו ללא קריסת המחשב. המחיר: פגיעה משמעותית בביצועים עקב תקורת החלפות הקשר (Context Switch) כבדה.';
                    } else if (archType === 'vm') {
                        title.textContent = 'מכונות מדומות (VM/370 / VMware)';
                        perfVal.textContent = 'בינוני (50%)';
                        perfBar.style.width = '50%';
                        stabVal.textContent = 'גבוהה (90%)';
                        stabBar.style.width = '90%';
                        sizeVal.textContent = 'בינוני (40%)';
                        sizeBar.style.width = '40%';
                        desc.innerHTML = '<strong>ניתוח:</strong> שכבת ה-Hypervisor מדמה את החומרה. מעולה לבידוד ותאימות לאחור (Guest OS לא יכולה להפיל מערכות אחרות). המחיר הוא ביצועים בגלל תקורה של הדמיית חומרה מורכבת.';
                    } else if (archType === 'exokernel') {
                        title.textContent = 'אקסו-קרנל (Exokernel / Nemesis)';
                        perfVal.textContent = 'אולטימטיבי (100%+)';
                        perfBar.style.width = '100%';
                        stabVal.textContent = 'בינונית (60%)';
                        stabBar.style.width = '60%';
                        sizeVal.textContent = 'מינימלי (5%)';
                        sizeBar.style.width = '5%';
                        desc.innerHTML = '<strong>ניתוח:</strong> הגרעין מוותר על כל הפשטה (אבסטרקציה) ומקצה משאבים בצורתם הגולמית. תוכנות משתמשות ב-Library OS ליישום ניהול הזיכרון או הקבצים. גמישות וביצועים ללא פשרות, אך הקוד של תוכנות המשתמש הופך מסובך וקשה לתחזוקה.';
                    }
                }, 50);
            }

            // Expose required methods to window
            window.showTab = showTab;
            window.toggleSidebar = toggleSidebar;
            window.nextStepSim = nextStepSim;
            window.prevStepSim = prevStepSim;
            window.resetSim = resetSim;
            window.runCrashTest = runCrashTest;

            // New Exposed functions
            window.selectPyramidLayer = selectPyramidLayer;
            window.triggerInterruptFlow = triggerInterruptFlow;
            window.nextInterruptStep = nextInterruptStep;
            window.resetInterruptSim = resetInterruptSim;
            window.selectMatchingCard = selectMatchingCard;
            window.resetMatchingGame = resetMatchingGame;
            window.showStateInfo = showStateInfo;

            window.runCrashTestArchitecture = runCrashTestArchitecture;
            window.resetCrashTestArchitecture = resetCrashTestArchitecture;
            window.setFlashcardMode = setFlashcardMode;
            window.filterFlashcards = filterFlashcards;
            window.toggleFlashcard = toggleFlashcard;
            window.resetFlashcards = resetFlashcards;

            window.selectConstraintTask = selectConstraintTask;
            window.selectConstraintSolution = selectConstraintSolution;
            window.triggerSegfault = triggerSegfault;
            window.updateArchSandbox = updateArchSandbox;
        }

        // הוסף את פונקציית העזר לציור קווים דינמיים לחלון:
        window.addEventListener('resize', () => {
            const svgEl = document.getElementById('constraint-lines-svg');
            if (!svgEl) return;

            // מחיקת הקווים הקיימים
            while (svgEl.firstChild) {
                svgEl.removeChild(svgEl.firstChild);
            }

            // שחזור הקווים לזיווגים הקיימים
            const gridEl = document.getElementById('constraint-lab-grid');
            const gridRect = gridEl.getBoundingClientRect();

            if (typeof constraintMatched !== 'undefined') {
                constraintMatched.forEach(taskId => {
                    const taskEl = document.getElementById('task-' + taskId);
                    const solEl = document.getElementById('sol-' + taskId);
                    if (taskEl && solEl) {
                        const taskRect = taskEl.getBoundingClientRect();
                        const solRect = solEl.getBoundingClientRect();

                        const x1 = taskRect.left + taskRect.width / 2 - gridRect.left;
                        const y1 = taskRect.top + taskRect.height / 2 - gridRect.top;
                        const x2 = solRect.left + solRect.width / 2 - gridRect.left;
                        const y2 = solRect.top + solRect.height / 2 - gridRect.top;

                        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                        line.setAttribute('x1', x1);
                        line.setAttribute('y1', y1);
                        line.setAttribute('x2', x2);
                        line.setAttribute('y2', y2);
                        line.setAttribute('stroke-width', '3');
                        line.setAttribute('stroke-linecap', 'round');
                        line.setAttribute('stroke', '#22c55e');
                        svgEl.appendChild(line);
                    }
                });
            }
        });
    </script>

    <!-- Repository of Guide Questions -->
    <div id="questions-repo" class="hidden">
        <div id="questions-os-essence">
            <details class="bg-blue-50/50 border border-blue-100 rounded-xl p-5 my-6 group transition-all duration-300">
                <summary class="font-bold text-blue-900 cursor-pointer list-none flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded font-black">שאלה מנחה 1.1</span>
                        <span>מדוע חייבת להיות אפשרות שהוראות מחשב של תוכניות משתמש יתבצעו בלי תיווך מערכת
                            ההפעלה?</span>
                    </span>
                    <span class="text-blue-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                </summary>
                <div class="mt-4 pt-4 border-t border-blue-100/50 text-slate-700 text-sm leading-relaxed">
                    <div class="thought-box">
                        <strong class="text-fuchsia-900 block mb-1">אסטרטגיית פתרון:</strong>
                        חשבו על התקורה והבזבוז הכרוכים במעבר בין מצבי המעבד (Context Switch ו-Mode Switch) עבור כל פקודה
                        פשוטה.
                    </div>
                    <strong class="text-slate-800">תשובה:</strong>
                    <p class="mt-2">
                        אם כל הוראה קטנה (כמו חיבור אוגרים, ביצוע לולאה או חישוב אריתמטי) הייתה מצריכה פנייה למערכת
                        ההפעלה דרך פקודת Trap ומעבר למצב גרעין, המחשב היה מתפקד באיטיות עצומה. התקורה של החלפת המצב
                        (Mode Switch) הייתה גוזלת את רוב זמן המעבד. לכן, הוראות שאינן מיוחסות (כמו חישובים רגילים)
                        חייבות לרוץ ישירות על החומרה במהירות מקסימלית ללא תיווך.
                    </p>
                </div>
            </details>
        </div>
        <div id="questions-os-history"></div>
        <div id="questions-os-hardware"></div>
        <div id="questions-os-zoo">
            <details class="bg-blue-50/50 border border-blue-100 rounded-xl p-5 my-6 group transition-all duration-300">
                <summary class="font-bold text-blue-900 cursor-pointer list-none flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded font-black">שאלה מנחה 1.4</span>
                        <span>במה נבדלים הצרכים של מחשב אישי ממערכות זמן-אמת (Real-Time)?</span>
                    </span>
                    <span class="text-blue-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                </summary>
                <div class="mt-4 pt-4 border-t border-blue-100/50 text-slate-700 text-sm leading-relaxed">
                    <strong class="text-slate-800">תשובה:</strong>
                    <p class="mt-2">
                        מחשב אישי מתמקד בממשק משתמש ובנוחות עבודה (GUI מורכב). מערכות זמן-אמת חייבות להבטיח זמני תגובה
                        מוחלטים ודטרמיניסטיים ללא עיכובים עבור משימות קריטיות (כמו ציוד רפואי או בקרי טיסה), תוך ויתור
                        על הוגנות או ממשק ויזואלי מתקדם.
                    </p>
                </div>
            </details>
        </div>
        <div id="questions-os-concepts">
            <details class="bg-blue-50/50 border border-blue-100 rounded-xl p-5 my-6 group transition-all duration-300">
                <summary class="font-bold text-blue-900 cursor-pointer list-none flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded font-black">שאלה מנחה 1.5</span>
                        <span>מה ההבדל בין "תוכנית" (Program) לבין "תהליך" (Process)?</span>
                    </span>
                    <span class="text-blue-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                </summary>
                <div class="mt-4 pt-4 border-t border-blue-100/50 text-slate-700 text-sm leading-relaxed">
                    <strong class="text-slate-800">תשובה:</strong>
                    <p class="mt-2">
                        <b>תוכנית</b> היא ישות פסיבית, קובץ הנמצא באופן סטטי על הדיסק הקשיח. לעומת זאת, <b>תהליך</b> הוא
                        תוכנית הנמצאת <b>בזמן ריצה</b> (ישות אקטיבית) וכוללת את תמונת הזיכרון שלה, אוגרי המעבד (כולל
                        Program Counter), המחסנית ומצבה הנוכחי.
                    </p>
                </div>
            </details>
            <details class="bg-blue-50/50 border border-blue-100 rounded-xl p-5 my-6 group transition-all duration-300">
                <summary class="font-bold text-blue-900 cursor-pointer list-none flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded font-black">שאלה מנחה 1.6</span>
                        <span>מהו ההבדל המהותי בין עץ תהליכים ב-UNIX לגישה ב-Windows?</span>
                    </span>
                    <span class="text-blue-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                </summary>
                <div class="mt-4 pt-4 border-t border-blue-100/50 text-slate-700 text-sm leading-relaxed">
                    <strong class="text-slate-800">תשובה:</strong>
                    <p class="mt-2">
                        במערכות UNIX יש מבנה <b>היררכי קשיח</b> – תהליך שמוליד צאצא אחראי עליו. כל התהליכים הם ענפים תחת
                        תהליך האב הקדמון <code>init</code>. לעומת זאת, ב-Windows נוצר <b>Handle</b> המצביע על הצאצא
                        וניתן להעברה, אך אין עץ יוחסין אקטיבי; כל התהליכים מנוהלים עצמאית על ידי ליבת המערכת ואין
                        מחויבות של האב כלפי הבן.
                    </p>
                </div>
            </details>
        </div>
        <div id="questions-os-syscalls">
            <details class="bg-blue-50/50 border border-blue-100 rounded-xl p-5 my-6 group transition-all duration-300">
                <summary class="font-bold text-blue-900 cursor-pointer list-none flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded font-black">שאלה מנחה 1.7</span>
                        <span>האם קיימת חובה טכנית למערכת ההפעלה לספק קריאות מערכת רשמיות? מדוע לא לאפשר כתיבה ישירה
                            לדיסק?</span>
                    </span>
                    <span class="text-blue-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                </summary>
                <div class="mt-4 pt-4 border-t border-blue-100/50 text-slate-700 text-sm leading-relaxed">
                    <strong class="text-slate-800">תשובה:</strong>
                    <p class="mt-2">
                        קריאות המערכת משמשות כ<b>שערי ההגנה היחידים</b> של מערכת ההפעלה. אילו ניתן היה לכל תוכנית לכתוב
                        ישירות לבקרי הדיסק (מצב שאינו אפשרי עקב הגנת ה-Mode Bit של המעבד), מערכת ההפעלה הייתה מאבדת את
                        יכולתה לנהל את המשאבים המשותפים, לבודד תהליכים זה מזה, או לאכוף הרשאות של אבטחת מידע.
                    </p>
                </div>
            </details>
        </div>
        <div id="questions-os-structure">
            <details class="bg-blue-50/30 border border-blue-100 rounded-xl p-5 group transition-all duration-300">
                <summary class="font-bold text-blue-900 cursor-pointer list-none flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded font-black">שאלה מנחה 1.2</span>
                        <span>מה היתרון של מערכת שמרכיביה מאורגנים ברבדים (קליפות) לעומת מערכת מונוליתית?</span>
                    </span>
                    <span class="text-blue-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                </summary>
                <div class="mt-4 pt-4 border-t border-blue-100/50 text-slate-700 text-sm leading-relaxed">
                    <strong class="text-slate-800">תשובה:</strong>
                    <p class="mt-2">
                        <b>מודולריות וקלות תחזוקה ופיתוח.</b> במערכת מרובדת, כל רובד מתבסס אך ורק על השירותים של הרובד
                        שמתחתיו ומציג ממשק מוגדר לרובד שמעליו. תכנון זה מאפשר לשנות, לעדכן או לאתר שגיאות ברובד בודד
                        מבלי להשפיע על שאר רכיבי המערכת, בעוד שבמערכת מונוליתית כל שינוי קוד קטן יכול להשפיע על המערכת
                        כולה ולגרום לקריסתה.
                    </p>
                </div>
            </details>
            <details class="bg-blue-50/30 border border-blue-100 rounded-xl p-5 group transition-all duration-300">
                <summary class="font-bold text-blue-900 cursor-pointer list-none flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded font-black">שאלה מנחה 1.3</span>
                        <span>מה הופך את המכונה המדומה (בסעיף 1.7.3) למערכת הפעלה?</span>
                    </span>
                    <span class="text-blue-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                </summary>
                <div class="mt-4 pt-4 border-t border-blue-100/50 text-slate-700 text-sm leading-relaxed">
                    <strong class="text-slate-800">תשובה:</strong>
                    <p class="mt-2">
                        המכונה המדומה (Hypervisor/VMM) היא שכבת תוכנה המנהלת ומקצה באופן בלעדי את המשאבים הפיזיים של
                        המחשב (מעבד, זיכרון, התקנים) ומציגה אבסטרקציה (וירטואלית) שלהם למערכות האורחות. לכן, היא ממלאת
                        את שני התפקידים המהותיים של מערכת הפעלה: <b>ניהול משאבים</b> ו<b>יצירת מכונה מדומה/מורחבת</b>.
                    </p>
                </div>
            </details>
            <details class="bg-blue-50/30 border border-blue-100 rounded-xl p-5 group transition-all duration-300">
                <summary class="font-bold text-blue-900 cursor-pointer list-none flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded font-black">שאלה מנחה 1.4</span>
                        <span>מהם היתרונות של מערכות לקוח-שרת (Microkernel)?</span>
                    </span>
                    <span class="text-blue-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                </summary>
                <div class="mt-4 pt-4 border-t border-blue-100/50 text-slate-700 text-sm leading-relaxed">
                    <strong class="text-slate-800">תשובה:</strong>
                    <p class="mt-2">
                        1. <b>אמינות ושרידות (Fault Tolerance):</b> שירותי מערכת ההפעלה (כמו מערכת הקבצים או מנהל הרשת)
                        רצים כתהליכים נפרדים במרחב משתמש. אם שרת קורס עקב באג, הוא אינו מפיל את כל המחשב וניתן לאתחל
                        אותו מחדש.
                        <br>2. <b>קלות הרחבה ותחזוקה:</b> ניתן להוסיף, לשנות או לעדכן שרתים ללא צורך לקמפל מחדש את
                        הגרעין.
                        <br>3. <b>התאמה לביזור:</b> מודל לקוח-שרת מתאים מאוד למערכות מבוזרות, כיוון שתהליך הלקוח ותהליך
                        השרת יכולים לרוץ פיזית על מחשבים שונים ברשת.
                    </p>
                </div>
            </details>
            <details class="bg-blue-50/30 border border-blue-100 rounded-xl p-5 group transition-all duration-300">
                <summary class="font-bold text-blue-900 cursor-pointer list-none flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded font-black">שאלה מנחה 1.5</span>
                        <span>לאור היתרונות המובהקים של מודל זה, מדוע הוא איננו מיושם תמיד?</span>
                    </span>
                    <span class="text-blue-500 transition-transform duration-200 group-open:rotate-180">▼</span>
                </summary>
                <div class="mt-4 pt-4 border-t border-blue-100/50 text-slate-700 text-sm leading-relaxed">
                    <div class="thought-box">
                        <strong class="text-fuchsia-900 block mb-1">אסטרטגיית פתרון ומלכודות קלאסיות:</strong>
                        זכרו תמיד את הטרייד-אוף ההנדסי: במערכת לקוח-שרת, קריאה לשירות מחייבת מעבר של הודעה (IPC) בין
                        תהליך הלקוח לשרת דרך הקרנל, בעוד שבמערכת מונוליתית מדובר בקריאת פונקציה מהירה.
                    </div>
                    <strong class="text-slate-800">תשובה:</strong>
                    <p class="mt-2">
                        <b>עקב פגיעה בביצועים.</b> במערכת מונוליתית, שירות מבוצע כקריאת פונקציה מהירה וישירה בתוך
                        הגרעין. במערכת לקוח-שרת (מיקרו-קרנל), קריאה לשירות מחייבת העברת הודעות (IPC) דרך הגרעין. תהליך
                        זה דורש מעברים מרובים בין מצב משתמש למצב מיוחס (Mode Switches) והחלפות הקשר (Context Switches)
                        בין תהליך הלקוח, המיקרו-קרנל ותהליך השרת, דבר המייצר תקורה כבדה ומאט את ביצועי המערכת.
                    </p>
                </div>
            </details>
        </div>
    </div>

    <!-- Questions Modal Overlay -->
    <div id="questions-modal"
        class="fixed inset-0 bg-slate-950/60 backdrop-blur-md z-50 flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300">
        <div
            class="bg-white border border-slate-200 w-full max-w-2xl mx-4 rounded-2xl shadow-2xl flex flex-col max-h-[80vh] transform scale-95 transition-all duration-300">
            <!-- Header -->
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                <h3 id="modal-title" class="text-lg font-bold text-slate-800 flex items-center gap-2">
                    <span>❓</span>
                    <span id="modal-section-name">שאלות מנחות ללימוד</span>
                </h3>
                <button onclick="closeQuestionsModal()"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer text-lg font-bold">&times;</button>
            </div>
            <!-- Body -->
            <div id="modal-body" class="p-6 overflow-y-auto space-y-4"></div>
            <!-- Footer -->
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end">
                <button onclick="closeQuestionsModal()"
                    class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-sm font-bold transition-all active:scale-95 cursor-pointer">סגור</button>
            </div>
        </div>
    </div>
    <script src="ai_widget.js"></script>
</body>

</html>
