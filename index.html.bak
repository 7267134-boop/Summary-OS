<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>מערכות הפעלה</title>
    
    <!-- Heebo Font for RTL Hebrew support -->
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Core Dependencies: TailwindCSS + Lucide Icons -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Tailwind Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        calmBg: '#f8fafc',
                        textMain: '#334155',
                    },
                    fontFamily: {
                        sans: ['Heebo', 'sans-serif'],
                    },
                    animation: {
                        'fade-in-up': 'fadeInUp 0.6s ease-out forwards',
                    },
                    keyframes: {
                        fadeInUp: {
                            '0%': {
                                opacity: '0',
                                transform: 'translateY(20px)',
                            },
                            '100%': {
                                opacity: '1',
                                transform: 'translateY(0)',
                            },
                        },
                    },
                    transitionDelay: {
                        '600': '0.6s',
                    },
                }
            }
        }
    </script>
    
    <style>
        body { 
            background-color: #f8fafc; 
            font-family: 'Heebo', sans-serif; 
        }
        
        /* Subtle Dot Pattern */
        .pattern-bg { 
            background-image: radial-gradient(#cbd5e1 2px, transparent 2px); 
            background-size: 32px 32px; 
        }
        
        /* SVG Wheel Styles */
        .slice-group {
            transform-origin: 400px 400px;
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
        }
        
        .slice-group:hover, .slice-group.active {
            transform: scale(1.06);
            z-index: 50;
            filter: drop-shadow(0 15px 25px rgba(0,0,0,0.15));
        }

        .slice-path {
            stroke-linejoin: round; /* Make corners rounded and soft */
            stroke-linecap: round;
            transition: all 0.3s ease;
        }
        
        /* Side Labels Styles */
        .side-label {
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
            position: relative;
        }
        
        .side-label:hover {
            transform: scale(1.04);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            z-index: 30;
        }
    </style>
</head>
<body class="text-textMain overflow-x-hidden flex flex-col min-h-screen">
    
    <!-- Hero Section -->
    <section class="relative w-full h-[55vh] flex flex-col items-center justify-center overflow-hidden bg-slate-900 rounded-b-[4rem] md:rounded-b-[100%] shadow-[0_30px_60px_-15px_rgba(0,0,0,0.3)] z-30">
        <div class="absolute inset-0 bg-gradient-to-b from-slate-900 via-sky-950 to-indigo-900 opacity-95"></div>
        <!-- Decorative circular glows -->
        <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[70%] bg-sky-500 rounded-full mix-blend-overlay filter blur-[120px] opacity-40"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[60%] h-[80%] bg-indigo-500 rounded-full mix-blend-overlay filter blur-[130px] opacity-40"></div>

        <div class="relative z-10 text-center px-4 w-full flex flex-col items-center">
            <div class="inline-block mb-5 px-6 py-2 rounded-full bg-white/5 backdrop-blur-lg text-sky-300 font-medium tracking-widest text-sm border border-white/10 shadow-lg">
                20594
            </div>
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-black text-white tracking-tight mb-4 drop-shadow-2xl">
                 <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-300 via-blue-300 to-indigo-300">מערכות הפעלה </span>
            </h1>
            <p class="text-lg md:text-2xl text-slate-300 max-w-2xl mx-auto font-light leading-relaxed drop-shadow-md">
                לימוד וסיכום הקורס מערכות הפעלה, מחולק לפי נושאים ובתוספת המחשות ויזואליות והכנה למבחן
            </p>
        </div>
    </section>

    <!-- Interactive Navigation App -->
    <div id="main-app" class="relative pattern-bg flex-grow flex flex-col items-center pt-32 pb-24 overflow-hidden z-20 -mt-20">
        
        <!-- Smooth top semicircular transition element -->
        <div class="absolute top-0 left-0 right-0 h-40 bg-gradient-to-b from-slate-900/5 to-transparent pointer-events-none"></div>

           <!-- Colored soft background blending (uses local image) -->
           <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120vw] h-[600px] pointer-events-none z-0 rounded-full"
               style="background-image: url('Gemini_Generated_Image_f0okz0f0okz0f0ok.png'); background-size: cover; background-position: center; filter: blur(100px); opacity: 0.95;"></div>

        <header class="relative z-10 px-4 text-center w-full mb-16">
            <h2 class="text-3xl md:text-3xl font-black text-slate-700 tracking-tight mb-4 drop-shadow-sm">אז למה צריך אתר לקורס? הסבר קצר על האתר:</h2>
            <p class="text-slate-500 text-lg md:text-xl font-light">
                הקורס מערכות הפעלה הוא אחד מהקורסים המעניינים ביותר בעיני, אבל מכיל המון חומר שבגלל מבנה הבחינה <strong class="text-sky-600 font-bold">כל החומר שכלול במדריך (ויותר...) חיוני לבחינה</strong> ולזה בדיוק נועד האתר- מעבר על המדריך זה די סזיפי ומתיש, ולכן לקחתי את חומר המדריך וסיכמתי אותו, הוספתי עזרים חזותיים ושאלות חזרה והתוצאה לפניכם: כל פרק באתר מקיף פרק במדריך ובנוסף פרק בונוס על החומר של הממנים, סיכום כולל של הקורס ויחידת תרגול מבחנים, בהצלחה :)
            </p>
        </header>

        <!-- Container for Split Halves and Center Wheel -->
        <div class="relative w-full max-w-[1400px] mx-auto min-h-[500px] md:min-h-[650px] rounded-[3rem] overflow-hidden flex flex-col md:flex-row shadow-2xl z-20 px-4 md:px-0">
            <!-- Right Half (Exams) - RTL visual right -->
            <a href="#exams" class="w-full md:w-1/2 flex flex-col items-center justify-center bg-gradient-to-l from-emerald-400 to-teal-400 text-white relative group transition-all duration-500 hover:brightness-110 min-h-[300px] md:min-h-auto flex-1 rounded-t-[3rem] md:rounded-t-none md:rounded-r-[3rem] overflow-hidden">
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-300"></div>
                <div class="flex flex-col items-center relative z-10 md:absolute md:right-[5%] lg:right-[15%]">
                    <div class="bg-white/20 p-4 md:p-6 rounded-full mb-3 shadow-[inset_0_2px_15px_rgba(255,255,255,0.4)] backdrop-blur-md group-hover:scale-110 transition-transform duration-500">
                        <i data-lucide="graduation-cap" class="w-8 h-8 md:w-16 md:h-16 stroke-[1.5]"></i>
                    </div>
                    <h3 class="text-2xl md:text-5xl font-black text-center leading-tight drop-shadow-lg">תרגול<br>מבחנים</h3>
                </div>
            </a>

            <!-- Left Half (Summaries) - RTL visual left -->
            <a href="#summaries" class="w-full md:w-1/2 flex flex-col items-center justify-center bg-gradient-to-r from-blue-500 to-indigo-500 text-white relative group transition-all duration-500 hover:brightness-110 min-h-[300px] md:min-h-auto flex-1 rounded-b-[3rem] md:rounded-b-none md:rounded-l-[3rem] overflow-hidden">
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-300"></div>
                <div class="flex flex-col items-center relative z-10 md:absolute md:left-[5%] lg:left-[15%]">
                    <div class="bg-white/20 p-4 md:p-6 rounded-full mb-3 shadow-[inset_0_2px_15px_rgba(255,255,255,0.4)] backdrop-blur-md group-hover:scale-110 transition-transform duration-500">
                        <i data-lucide="book-open" class="w-8 h-8 md:w-16 md:h-16 stroke-[1.5]"></i>
                    </div>
                    <h3 class="text-2xl md:text-5xl font-black text-center leading-tight drop-shadow-lg">מעבר<br>לסיכום</h3>
                </div>
            </a>

            <!-- The Central Interactive Wheel -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[340px] md:w-[580px] lg:w-[600px] aspect-square flex-shrink-0 z-30 drop-shadow-[0_20px_50px_rgba(0,0,0,0.25)] hover:scale-[1.02] transition-transform duration-700 bg-white/30 p-2 md:p-4 rounded-full backdrop-blur-3xl border border-white/60">
                <div class="w-full h-full relative bg-white/95 rounded-full shadow-[inset_0_10px_30px_rgba(0,0,0,0.05)] flex items-center justify-center">
                    <!-- SVG absolutely positioned, bounds exceed center slightly but stay within rounded container -->
                    <svg id="wheel-svg" viewBox="0 0 800 800" class="w-[105%] h-[105%] absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 overflow-visible"></svg>
                    
                    <!-- Center Bubble (Content Only) -->
                    <div class="absolute w-[60%] h-[60%] bg-white rounded-full shadow-[0_20px_50px_rgba(0,0,0,0.15)] flex flex-col items-center justify-center text-center p-6 md:p-12 z-10 transition-all duration-500 border-[6px] md:border-[10px] border-slate-50">
                        <div id="center-content" class="w-full h-full flex flex-col items-center justify-center transition-opacity duration-300 opacity-100">
                            <div id="preview-badge" class="inline-flex items-center justify-center mb-2 md:mb-4 px-4 py-1.5 rounded-full font-bold text-xs md:text-sm transition-colors duration-300 shadow-sm border border-transparent">
                                פרק <span id="preview-number" class="mr-1.5">1</span>
                            </div>
                            <h3 id="preview-title" class="text-xl md:text-3xl font-black text-slate-800 mb-2 md:mb-4 leading-tight tracking-tight px-1 drop-shadow-sm">
                                מבוא
                            </h3>
                            <p id="preview-desc" class="text-xs md:text-[15px] text-slate-500 leading-relaxed max-w-[180px] md:max-w-[280px] font-medium px-2">
                                הקדמה כללית לקורס, סקירת משפחות של שפות תכנות והבנת תהליכי קומפילציה מול אינטרפרטציה.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Smooth bottom semicircular transition element into the footer -->
    <div class="relative w-full h-24 md:h-32 bg-white rounded-t-[100%] shadow-[0_-20px_40px_rgba(0,0,0,0.03)] -mt-20 z-30"></div>

    <!-- Footer Section -->
    <footer class="bg-white pb-8 relative z-30 mt-auto">
        <div class="container mx-auto px-4 flex flex-col items-center">
            
            <h4 class="text-center text-slate-400 font-bold text-sm uppercase tracking-widest mb-5 mt-[-1rem]">קישורים מהירים</h4>
            
                    <!-- רשתות חברתיות ויצירת קשר -->
            <div class="flex justify-center items-center gap-6 mt-16 mb-4 opacity-0 animate-fade-in-up delay-600">
                <!-- לינקדאין -->
                <a href="https://linkedin.com/in/yair-kurtzman-382417247" target="_blank" title="LinkedIn"
                    class="group w-14 h-14 bg-white rounded-2xl flex items-center justify-center shadow-sm border border-slate-200 hover:border-sky-400 hover:bg-sky-50 hover:shadow-lg hover:shadow-sky-100 hover:-translate-y-2 hover:scale-105 transition-all duration-300 text-slate-400">
                    <svg class="w-6 h-6 group-hover:text-sky-600 transition-colors" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd"
                        d="M12.51 8.796v1.697a3.738 3.738 0 0 1 3.288-1.684c3.455 0 4.202 2.16 4.202 4.97V19.5h-3.2v-5.072c0-1.21-.244-2.766-2.128-2.766-1.827 0-2.139 1.317-2.139 2.676V19.5h-3.19V8.796h3.168ZM7.2 6.106a1.61 1.61 0 0 1-1.61 1.61h-.022A1.61 1.61 0 0 1 3.96 6.106a1.61 1.61 0 1 1 3.24 0ZM7.18 19.5H4V8.796h3.18V19.5Z"
                        clip-rule="evenodd" />
                    </svg>
                </a>

                <!-- גיטהב -->
                <a href="https://github.com/7267134-boop/Summary-of-programming-languages.git" target="_blank"
                    title="GitHub"
                    class="group w-14 h-14 bg-white rounded-2xl flex items-center justify-center shadow-sm border border-slate-200 hover:border-slate-800 hover:bg-slate-50 hover:shadow-lg hover:shadow-slate-200 hover:-translate-y-2 hover:scale-105 transition-all duration-300 text-slate-400">
                    <svg class="w-6 h-6 group-hover:text-slate-800 transition-colors" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd"
                            d="M12.006 2a9.847 9.847 0 0 0-6.484 2.44 10.32 10.32 0 0 0-3.393 6.17 10.48 10.48 0 0 0 1.317 6.955 10.045 10.045 0 0 0 5.4 4.418c.504.095.683-.223.683-.494 0-.245-.01-1.052-.014-1.908-2.78.62-3.366-1.21-3.366-1.21a2.711 2.711 0 0 0-1.11-1.5c-.907-.637.07-.621.07-.621.995.076 1.52 1.05 1.52 1.05a2.12 2.12 0 0 0 2.895.845 2.146 2.146 0 0 1 .637-1.378c-2.22-.26-4.554-1.144-4.554-5.06a3.94 3.94 0 0 1 1.04-2.72 3.73 3.73 0 0 1 .1-2.68s.84-.277 2.75 1.05a9.42 9.42 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05a3.73 3.73 0 0 1 .1 2.68 3.94 3.94 0 0 1 1.04 2.72c0 3.926-2.338 4.8-4.564 5.05.334.298.63.882.63 1.776 0 1.282-.012 2.316-.012 2.632 0 .274.177.595.688.491a10.046 10.046 0 0 0 5.394-4.42A10.48 10.48 0 0 0 22 10.606a10.318 10.318 0 0 0-3.4-6.166A9.845 9.845 0 0 0 12.006 2Z"
                            clip-rule="evenodd" />
                    </svg>
                </a>

                <!-- אימייל -->
                <a href="mailto:7267134@gmail.com?subject=הצעות לתיקונים" title="הצעות לתיקונים"
                    class="group w-14 h-14 bg-white rounded-2xl flex items-center justify-center shadow-sm border border-slate-200 hover:border-emerald-400 hover:bg-emerald-50 hover:shadow-lg hover:shadow-emerald-100 hover:-translate-y-2 hover:scale-105 transition-all duration-300 text-slate-400">
                    <svg class="w-6 h-6 group-hover:text-emerald-500 transition-colors" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                        stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </a>

                <!-- עיגול רביעי (MEGA) -->
                <a href="https://mega.nz/folder/bZgRnQbJ#fBIkzvx7nLDUFMq गुरुGad6jOw/folder/fZwE1CZZ" target="_blank"
                    title="MEGA"
                    class="group w-14 h-14 bg-white rounded-2xl flex items-center justify-center shadow-sm border border-slate-200 hover:border-indigo-400 hover:bg-indigo-50 hover:shadow-lg hover:shadow-indigo-100 hover:-translate-y-2 hover:scale-105 transition-all duration-300 text-slate-400">
                    <svg class="w-6 h-6 group-hover:text-indigo-500 transition-colors" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                        stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9" />
                    </svg>
                </a>
            </div>
            
            <div class="max-w-3xl text-center px-4">
                <p class="text-slate-500 text-base md:text-lg leading-relaxed mb-4 font-light">
                  למידה מהנה ובהצלחה! <br>
                 התוכן של האתר נערך ונסקר מכל הכיוונים על ידי, אבל עדיין האתר נבנה בעזרת בינה מלאכותית ולכן יתכנו טעויות, אשמח לעדכון אם מצאתם על מנת שאוכל לתקן. <br>
                </p>
                <div class="w-16 h-1 bg-slate-200 mx-auto rounded-full mb-4"></div>
                <p class="text-slate-400 text-sm">© כל הזכויות שמורות - יאיר קורצמן</p>
            </div>
        </div>
    </footer>

    <script>
        // Init Icons
        lucide.createIcons();

        // Data for chapters
        const chaptersData = [
            { id: 1, title: 'מבוא', desc: 'פרק זה סוקר את ההיסטוריה והתפתחות מערכות ההפעלה, הגדרתן, וסוגיהן השונים. בנוסף, הוא מציג את מושגי היסוד, מנגנון קריאות המערכת, והמבנים הארכיטקטוניים השונים המרכיבים אותן.', link: 'chapter_1.html' },
            { id: 2, title: 'תהליכים ותהליכונים ', desc: 'הפרק עוסק במחזור החיים של תהליכים ותהליכונים ובאופן שבו המערכת מתזמנת אותם. כמו כן, מאוזכרים בו אתגרי תקשורת בין תהליכים (IPC), בעיות סנכרון ומצבי מרוץ, והכלים לפתרונן כגון סמפורים.', link: 'chapter_2.html' },
            { id: 3, title: 'ניהול זיכרון', desc: 'פרק זה מונה את נושאי הקצאת הזיכרון הראשי, בדגש על זיכרון מדומה ומנגנון הדפדוף (Paging). בנוסף, נסקרים בו שיטות תרגום הכתובות והאלגוריתמים השונים האחראים על החלפת דפים בזיכרון.', link: 'chapter_3.html' },
            { id: 4, title: 'מערכת קבצים', desc: 'מהפרק בוחן את הארגון הלוגי של קבצים ותיקיות במערכת, לצד אופן יישומם הפיזי על גבי הדיסק. מוזכרים בו גם אופן ניהול השטח הפנוי, דרכים לשמירה על עקביות המידע ואופטימיזציה של ביצועים.', link: 'chapter_4.html' },
            { id: 5, title: 'קלט ופלט', desc: 'מפרק זה סוקר את ממשק מערכת ההפעלה מול החומרה החיצונית, וכולל אזכור לבקרי התקנים וגישה ישירה לזיכרון (DMA). בנוסף, מפורטים בו מנהלי פסיקות, מנהלי התקנים (Drivers), ואלגוריתמים לתזמון דיסקים.', link: 'chapter_5.html' },
            { id: 6, title: 'קיפאון', desc: 'הפרק מוקדש לתופעת הקיפאון ומפרט את התנאים ההכרחיים להיווצרותה במערכת. כמו כן, מוצגות בו הגישות השונות להתמודדות עם התופעה: התעלמות, גילוי והיחלצות, מניעה או הימנעות.', link: 'chapter_6.html' },
            { id: 7, title: 'וירטואליזציה וענן', desc: 'מפרק זה סוקר את עקרונות הווירטואליזציה ומחשוב הענן, בדגש על תוכנות ניהול מכונות וירטואליות (Hypervisor). הוא נוגע גם באתגרים שבווירטואליזציה של המעבד, הזיכרון והתקני הקלט/פלט.', link: 'chapter_7.html' },
            { id: 8, title: 'מערכות מרובות מעבדים' , desc: 'הפרק עוסק בהתאמות הנדרשות ממערכת ההפעלה כאשר היא רצה על מחשב בעל מספר מעבדים. הנושאים הנסקרים כוללים חלוקת עומסים, תזמון מורכב ואתגרי סנכרון בסביבת זיכרון משותף.', link: 'chapter_8.html' },
            { id: 9, title: 'נספח- מעט על בטיחות', desc: 'הנספח סוקר בקצרה את נושאי האבטחה והבטיחות במערכת ההפעלה. הוא מזכיר מושגים ומנגנונים כמו תחומי הגנה ורשימות בקרת גישה (ACL) לשמירה על המערכת.', link: 'chapter_9.html' },
            { id: 10, title: 'לינוקס, xv6 ו-DOCKER', desc: 'הצגת לינוקס, והסבר רעיוני על מערכת ההפעלה xv6, המטלות וDOCKER', link: 'chapter_10.html' }
        ];

        const rainbowColors = [
            '#fb7185', '#fb923c', '#facc15', '#a3e635', '#34d399',
            '#2dd4bf', '#38bdf8', '#60a5fa', '#818cf8', '#c084fc'
        ];

        let activeChapterId = 1;
        const svg = document.getElementById('wheel-svg');
        const contentWrapper = document.getElementById('center-content');
        const previewTitle = document.getElementById('preview-title');
        const previewDesc = document.getElementById('preview-desc');
        const previewNumber = document.getElementById('preview-number');
        const previewBadge = document.getElementById('preview-badge');

        const CX = 400; 
        const CY = 400; 
        const RADIUS = 320; 
        const SLICES = chaptersData.length;
        const ANGLE_STEP = (Math.PI * 2) / SLICES;

        const progressSegments = [];
        const nodeCircles = [];
        const nodeTexts = [];

        function hexToRgba(hex, alpha) {
            let r = parseInt(hex.slice(1, 3), 16),
                g = parseInt(hex.slice(3, 5), 16),
                b = parseInt(hex.slice(5, 7), 16);
            return `rgba(${r}, ${g}, ${b}, ${alpha})`;
        }

        function polarToCartesian(centerX, centerY, radius, angleInRadians) {
            return {
                x: centerX + (radius * Math.cos(angleInRadians)),
                y: centerY + (radius * Math.sin(angleInRadians))
            };
        }

        function initWheel() {
            svg.innerHTML = ''; 
            
            // 1. Draw base track
            const track = document.createElementNS("http://www.w3.org/2000/svg", "circle");
            track.setAttribute("cx", CX);
            track.setAttribute("cy", CY);
            track.setAttribute("r", RADIUS);
            track.setAttribute("fill", "none");
            track.setAttribute("stroke", "rgba(0,0,0,0.03)");
            track.setAttribute("stroke-width", "12");
            svg.appendChild(track);

            // 2. Draw Progress Segments
            for (let i = 0; i < SLICES; i++) {
                const startAngle = -Math.PI / 2 + (i * ANGLE_STEP);
                const endAngle = startAngle + ANGLE_STEP;
                
                const startP = polarToCartesian(CX, CY, RADIUS, startAngle);
                const endP = polarToCartesian(CX, CY, RADIUS, endAngle);
                
                const d = [
                    "M", startP.x, startP.y,
                    "A", RADIUS, RADIUS, 0, 0, 1, endP.x, endP.y
                ].join(" ");

                const segment = document.createElementNS("http://www.w3.org/2000/svg", "path");
                segment.setAttribute("d", d);
                segment.setAttribute("fill", "none");
                segment.setAttribute("stroke-width", "14");
                segment.style.transition = "stroke 0.4s ease-in-out, opacity 0.4s ease-in-out";
                segment.style.opacity = "0";
                progressSegments.push(segment);
                svg.appendChild(segment);
            }

            // 3. Draw nodes
            chaptersData.forEach((chapter, index) => {
                const angle = -Math.PI / 2 + (index * ANGLE_STEP);
                const pos = polarToCartesian(CX, CY, RADIUS, angle);
                
                const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
                circle.setAttribute("cx", pos.x);
                circle.setAttribute("cy", pos.y);
                circle.style.transition = "all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)";
                nodeCircles.push(circle);
                svg.appendChild(circle);
                
                const textNum = document.createElementNS("http://www.w3.org/2000/svg", "text");
                textNum.setAttribute("x", pos.x);
                textNum.setAttribute("y", pos.y);
                textNum.setAttribute("text-anchor", "middle");
                textNum.setAttribute("dominant-baseline", "central");
                textNum.setAttribute("dy", "0.1em");
                textNum.textContent = chapter.id;
                nodeTexts.push(textNum);
                svg.appendChild(textNum);
            });

            // 4. Draw Hitboxes (Thick Arcs covering the entire segment)
            chaptersData.forEach((chapter, index) => {
                const startAngle = -Math.PI / 2 + (index - 0.5) * ANGLE_STEP;
                const endAngle = -Math.PI / 2 + (index + 0.5) * ANGLE_STEP;

                const startP = polarToCartesian(CX, CY, RADIUS, startAngle);
                const endP = polarToCartesian(CX, CY, RADIUS, endAngle);
                
                const largeArcFlag = ((endAngle - startAngle) <= Math.PI) ? "0" : "1";
                
                const d = [
                    "M", startP.x, startP.y,
                    "A", RADIUS, RADIUS, 0, largeArcFlag, 1, endP.x, endP.y
                ].join(" ");

                const hitbox = document.createElementNS("http://www.w3.org/2000/svg", "path");
                hitbox.setAttribute("d", d);
                hitbox.setAttribute("fill", "none");
                hitbox.setAttribute("stroke", "transparent");
                hitbox.setAttribute("stroke-width", "80");
                hitbox.setAttribute("class", "cursor-pointer outline-none");
                
                hitbox.addEventListener('mouseenter', () => updateCenter(chapter.id, rainbowColors[index]));
                hitbox.addEventListener('click', () => { window.location.href = chapter.link; });
                hitbox.addEventListener('touchstart', (e) => {
                    e.preventDefault();
                    updateCenter(chapter.id, rainbowColors[index]);
                });
                hitbox.addEventListener('touchend', (e) => {
                    if (activeChapterId === chapter.id) {
                        window.location.href = chapter.link;
                    }
                });

                svg.appendChild(hitbox);
            });
        }

        function updateWheelState() {
            const activeIndex = chaptersData.findIndex(c => c.id === activeChapterId);
            const activeColor = rainbowColors[activeIndex];

            // Update Progress Segments
            progressSegments.forEach((segment, index) => {
                if (index < activeIndex) {
                    segment.setAttribute("stroke", rainbowColors[(index + 1) % rainbowColors.length]);
                    segment.style.opacity = "1";
                } else {
                    segment.style.opacity = "0";
                }
            });

            // Update Nodes
            chaptersData.forEach((chapter, index) => {
                const color = rainbowColors[index];
                const isActive = chapter.id === activeChapterId;
                const isPassed = index <= activeIndex;
                
                const circle = nodeCircles[index];
                circle.setAttribute("r", isActive ? "28" : "20");
                circle.setAttribute("fill", isPassed ? (isActive ? activeColor : "#f8fafc") : "#ffffff");
                circle.setAttribute("stroke", isPassed ? (isActive ? "#ffffff" : color) : "#e2e8f0");
                circle.setAttribute("stroke-width", isActive ? "6" : "3");
                
                const textNum = nodeTexts[index];
                textNum.setAttribute("class", `text-${isActive ? '2xl' : 'lg'} font-black pointer-events-none transition-colors duration-300`);
                textNum.setAttribute("fill", (isPassed && !isActive) ? "#0f172a" : (isActive ? "#ffffff" : "#94a3b8"));
            });
        }

        function updateCenter(id, overrideColor = null) {
            if (activeChapterId === id && overrideColor === null) return;
            activeChapterId = id;
            
            const chapterIndex = chaptersData.findIndex(c => c.id === id);
            const chapter = chaptersData[chapterIndex];
            const activeColor = overrideColor || rainbowColors[chapterIndex];

            updateWheelState();
            
            contentWrapper.style.opacity = '0';
            
            setTimeout(() => {
                previewNumber.textContent = chapter.id;
                previewTitle.textContent = chapter.title;
                previewDesc.textContent = chapter.desc;
                
                previewBadge.style.backgroundColor = hexToRgba(activeColor, 0.15);
                previewBadge.style.color = activeColor;
                previewBadge.style.borderColor = activeColor;
                
                contentWrapper.style.opacity = '1';
            }, 150); 
        }

        document.addEventListener('DOMContentLoaded', () => {
            initWheel();
            updateCenter(1, rainbowColors[0]);
        });
    </script>
</body>
</html>
